<ips:template parameters="$counts, $total, $stateList, $laws, $enacted, $pending, $activeState, $activeType, $dateFrom, $dateTo, $lastUpdated, $shownLabel, $pageUrl, $typeUrls, $clearUrl, $sessionNote" />
<div class="gd-bills">

	<header class="gd-bills__hero">
		<h1>{lang="gdbills_page_title"}</h1>
		<p class="gd-bills__sub">{lang="gdbills_page_subtitle"}</p>
		{{if $sessionNote}}
		<p class="gd-bills__note">{$sessionNote}</p>
		{{endif}}
	</header>

	<section class="gd-bills__mapPanel">
		<div class="gd-bills__mapHead">
			<div>
				<h2 class="gd-bills__mapTitle">{lang="gdbills_state_map_title"}</h2>
				<p class="gd-bills__mapHint">{lang="gdbills_state_map_hint"}</p>
			</div>
			<div class="gd-bills__totalCount">
				<div class="gd-bills__totalValue">{expression="number_format($total)"}</div>
				<div class="gd-bills__totalLabel">tracked</div>
			</div>
		</div>

		<div class="gd-bills__map" id="gdBillsMap">
			{{foreach $stateList as $code}}
				{{$c = isset($counts[$code]) ? (int) $counts[$code] : 0;}}
				{{$bucket = '';}}
				{{if $c <= 0}}{{$bucket = 'is-empty';}}
				{{elseif $c <= 2}}{{$bucket = 'is-bucket-1';}}
				{{elseif $c <= 5}}{{$bucket = 'is-bucket-2';}}
				{{elseif $c <= 10}}{{$bucket = 'is-bucket-3';}}
				{{else}}{{$bucket = 'is-bucket-4';}}{{endif}}
				{{$activeCls = ( $activeState === $code ) ? ' is-active' : '';}}
				{{$ga = strtolower($code);}}
				{{if $c > 0}}
				<a class="gd-bills__tile {$bucket}{$activeCls}" style="grid-area: {$ga}" href="{$pageUrl}?state={$code}" title="{$code}: {$c}">{$code}<small>{$c}</small></a>
				{{else}}
				<span class="gd-bills__tile is-empty" style="grid-area: {$ga}" title="{$code}: 0">{$code}</span>
				{{endif}}
			{{endforeach}}
		</div>
	</section>

	<div class="gd-bills__controls">
		{{if $activeState}}
		<div class="gd-bills__breadcrumb">
			<a href="{$pageUrl}" class="gd-bills__back">&larr; {lang="gdbills_back_all_states"}</a>
			<span class="gd-bills__breadcrumbActive">{$activeState}</span>
		</div>
		{{endif}}

		{{if $lastUpdated}}
		<div class="gd-bills__updated">
			<strong>{lang="gdbills_last_updated"}:</strong> {$lastUpdated}
		</div>
		{{endif}}

		<section class="gd-bills__filters" aria-label="Filters">
			<div class="gd-bills__filterGroup">
				<span class="gd-bills__filterLabel">{lang="gdbills_filter_type"}:</span>
				<a class="gd-bills__filterBtn gd-bills__filterBtn--all{{if $activeType === 'all'}} is-active{{endif}}"         href="{$typeUrls['all']}">{lang="gdbills_filter_all"}</a>
				<a class="gd-bills__filterBtn gd-bills__filterBtn--law{{if $activeType === 'law'}} is-active{{endif}}"         href="{$typeUrls['law']}">{lang="gdbills_filter_law"}</a>
				<a class="gd-bills__filterBtn gd-bills__filterBtn--enacted{{if $activeType === 'enacted'}} is-active{{endif}}" href="{$typeUrls['enacted']}">{lang="gdbills_filter_enacted"}</a>
				<a class="gd-bills__filterBtn gd-bills__filterBtn--pending{{if $activeType === 'pending'}} is-active{{endif}}" href="{$typeUrls['pending']}">{lang="gdbills_filter_pending"}</a>
			</div>
			<form class="gd-bills__filterGroup gd-bills__dateForm" method="get" action="{$pageUrl}">
				{{if $activeState}}<input type="hidden" name="state" value="{$activeState}">{{endif}}
				{{if $activeType !== 'all'}}<input type="hidden" name="type" value="{$activeType}">{{endif}}
				<span class="gd-bills__filterLabel">{lang="gdbills_filter_date"}:</span>
				<label class="gd-bills__dateField">
					<span>{lang="gdbills_filter_from"}</span>
					<input type="date" name="date_from" value="{$dateFrom}">
				</label>
				<label class="gd-bills__dateField">
					<span>{lang="gdbills_filter_to"}</span>
					<input type="date" name="date_to" value="{$dateTo}">
				</label>
				<button type="submit" class="gd-bills__filterBtn gd-bills__filterBtn--apply">{lang="gdbills_filter_apply"}</button>
				<a class="gd-bills__filterBtn gd-bills__filterBtn--clear" href="{$clearUrl}">{lang="gdbills_filter_clear"}</a>
			</form>
		</section>

		{{if $activeState || $activeType !== 'all' || $dateFrom || $dateTo}}
		<div class="gd-bills__showing">{$shownLabel}</div>
		{{endif}}
	</div>

	{{if $activeState || $activeType !== 'all' || $dateFrom || $dateTo}}
		{{if count($laws) === 0 && count($enacted) === 0 && count($pending) === 0}}
			<div class="gd-bills__empty">
				<p>{lang="gdbills_no_bills"}</p>
			</div>
		{{else}}
			{{if ( $activeType === 'all' || $activeType === 'law' ) && count($laws) > 0}}
			<section class="gd-bills__section">
				<h2 class="gd-bills__sectionTitle gd-bills__sectionTitle--law">{lang="gdbills_law_heading"} ({expression="count($laws)"})</h2>
				<div class="gd-bills__list">
					{{foreach $laws as $b}}
						{template="billRow" group="bills" app="gdbills" params="$b"}
					{{endforeach}}
				</div>
			</section>
			{{endif}}

			{{if ( $activeType === 'all' || $activeType === 'enacted' ) && count($enacted) > 0}}
			<section class="gd-bills__section">
				<h2 class="gd-bills__sectionTitle gd-bills__sectionTitle--enacted">{lang="gdbills_enacted_heading"} ({expression="count($enacted)"})</h2>
				<div class="gd-bills__list">
					{{foreach $enacted as $b}}
						{template="billRow" group="bills" app="gdbills" params="$b"}
					{{endforeach}}
				</div>
			</section>
			{{endif}}

			{{if ( $activeType === 'all' || $activeType === 'pending' ) && count($pending) > 0}}
			<section class="gd-bills__section">
				<h2 class="gd-bills__sectionTitle gd-bills__sectionTitle--pending">{lang="gdbills_pending_heading"} ({expression="count($pending)"})</h2>
				<div class="gd-bills__list">
					{{foreach $pending as $b}}
						{template="billRow" group="bills" app="gdbills" params="$b"}
					{{endforeach}}
				</div>
			</section>
			{{endif}}
		{{endif}}
	{{endif}}

</div>
