<ips:template parameters="$query, $results, $total, $pagination" />
<div class="ipsBox">
	<div style="padding:20px">
		<form method="get" action="{url="app=gdsearch&module=search&controller=results"}">
			<div style="display:flex;gap:8px">
				<input type="text" name="q" class="ipsInput ipsInput--text" style="flex:1" value="{$query}" placeholder="{lang="gdsearch_search_placeholder"}">
				<button type="submit" class="ipsButton ipsButton--primary">{lang="gdsearch_results_title"}</button>
			</div>
		</form>
	</div>
	{{if $query}}
	<div style="padding:0 20px 20px">
		<p style="color:#666;font-size:0.9em">{expression="sprintf( \IPS\Member::loggedIn()->language()->addToStack('gdsearch_total_results'), number_format($total) )"}</p>
		{{if count($results) === 0}}
		<p>{lang="gdsearch_no_results"}</p>
		{{else}}
		<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
			{{foreach $results as $product}}
			<div style="border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;background:#fff">
				{{if $product['image_url']}}
				<img src="{$product['image_url']}" style="width:100%;height:160px;object-fit:contain;background:#f8f9fa" alt="{$product['title']}">
				{{endif}}
				<div style="padding:12px">
					<div style="font-size:0.8em;color:#666;margin-bottom:4px">{$product['brand']}</div>
					<div style="font-weight:600;margin-bottom:8px;font-size:0.95em">{$product['title']}</div>
					{{if $product['best_price']}}
					<div style="color:#16a34a;font-weight:700;font-size:1.1em">${expression="number_format($product['best_price'],2)"}</div>
					<div style="font-size:0.8em;color:#666">{expression="sprintf( \IPS\Member::loggedIn()->language()->addToStack('gdsearch_dealers_from'), $product['dealer_count'] )"}</div>
					{{else}}
					<div style="color:#999;font-size:0.85em">{lang="gdsearch_out_of_stock"}</div>
					{{endif}}
					{{if $product['requires_ffl']}}<span class="ipsBadge ipsBadge--warning" style="font-size:0.75em;margin-top:6px;display:inline-block">{lang="gdsearch_requires_ffl"}</span>{{endif}}
				</div>
			</div>
			{{endforeach}}
		</div>
		{{if $pagination}}<div style="margin-top:20px">{$pagination|raw}</div>{{endif}}
		{{endif}}
	</div>
	{{endif}}
</div>
