<ips:template parameters="$product, $listings, $categoryName, $backUrl, $restrictedStatesStr, $priceChartSvg, $priceChartJson, $priceAllTimeLow, $alertLoggedIn, $alertThreshold, $alertSetUrl, $alertCancelUrl, $alertCsrfKey, $alertCurrent, $alertLoginUrl, $wishLoggedIn, $wishlisted, $wishAddUrl, $wishRemoveUrl, $wishLoginUrl, $wishCsrfKey, $reportLoggedIn, $reportUrl, $reportLoginUrl, $reportCsrfKey, $listingReportUrl='', $listingReportLoggedIn=false, $listingReportCsrfKey='', $listingReportLoginUrl='', $offersSort='standard', $sortOptions=array(), $sortBaseUrl='', $restrictionRows=array(), $advisoryRows=array(), $reviewsHtml='', $reviewCount=0, $reviewRating=null" />
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
.gdsp-wrap{width:100%;margin:0;padding:18px;box-sizing:border-box;font-family:'Inter',system-ui,-apple-system,sans-serif;color:#0f172a}
.gdsp-back{display:inline-flex;align-items:center;gap:6px;color:#64748b;text-decoration:none;margin-bottom:14px;font-size:.88em}
.gdsp-back:hover{color:#1e40af}
.gdsp-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-sizing:border-box}
.gdsp-card+.gdsp-card{margin-top:16px}
.gdsp-main{padding:22px}
.gdsp-grid{display:grid;grid-template-columns:215px 1fr;gap:26px;align-items:start}
.gdsp-imgbox{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;display:flex;align-items:center;justify-content:center;min-height:200px}
.gdsp-imgbox img{max-width:100%;max-height:280px;object-fit:contain}
.gdsp-zoom-cb{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
.gdsp-imgbox{cursor:zoom-in}
.gdsp-lightbox{display:none;position:fixed;inset:0;z-index:1200;background:rgba(15,23,42,.85);align-items:center;justify-content:center;padding:24px;cursor:zoom-out}
.gdsp-zoom-cb:checked ~ .gdsp-lightbox{display:flex}
.gdsp-lightbox img{max-width:92vw;max-height:92vh;object-fit:contain;border-radius:10px;box-shadow:0 12px 48px rgba(0,0,0,.45)}
.gdsp-lightbox-x{position:absolute;top:16px;right:24px;color:#fff;font-size:2.2em;line-height:1;font-weight:300}
.gdsp-noimg{background:#f1f5f9;border-radius:12px;height:210px;display:flex;align-items:center;justify-content:center;color:#cbd5e1;font-size:3em}
.gdsp-rail .gdsp-action{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;margin-top:8px;padding:11px;border-radius:10px;font-size:.84em;font-weight:600;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#334155;box-sizing:border-box;text-decoration:none;line-height:1.1}
.gdsp-rail .gdsp-action:hover{border-color:#cbd5e1;background:#f8fafc}
.gdsp-rail .gdsp-action--first{margin-top:14px}
.gdsp-rail .gdsp-action--amber{background:#fef3c7;border-color:#fcd34d;color:#92400e}
.gdsp-rail .gdsp-action--amber:hover{background:#fde68a}
.gdsp-rail .gd-wish-trigger.ipsButton--positive{background:#dcfce7;border-color:#86efac;color:#15803d}
.gdsp-rail .gdsp-action--report{border:none;color:#94a3b8;font-weight:500;font-size:.8em;margin-top:6px}
.gdsp-rail .gdsp-action--report:hover{background:none;color:#64748b}
.gdsp-kick{color:#1e40af;font-size:.78em;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
.gdsp-title{margin:0 0 10px;font-size:1.5em;line-height:1.3;color:#0f172a;font-weight:600}
.gdsp-badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.gdsp-buy{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 16px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:18px}
.gdsp-buy-lbl{font-size:.66em;font-weight:700;letter-spacing:.06em;color:#16a34a;text-transform:uppercase}
.gdsp-buy-amt{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:1.7em;color:#0f172a;line-height:1.15}
.gdsp-buy-meta{font-size:.82em;color:#64748b;margin-top:2px}
.gdsp-buy-meta b{color:#16a34a;font-weight:600}
.gdsp-buy-cta{margin-left:auto}
.gdsp-buy-btn{display:inline-block;background:#f59e0b;color:#7c2d12;border:none;font-weight:700;font-size:.85em;padding:11px 18px;border-radius:10px;cursor:pointer;text-decoration:none;white-space:nowrap}
.gdsp-buy-btn:hover{background:#d97706;color:#fff}
.gdsp-spec-h{font-size:.72em;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin:0 0 12px}
.gdsp-specs{display:grid;grid-template-columns:1fr 1fr;gap:9px 26px;font-size:.92em;line-height:1.45}
.gdsp-specs>div{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #f5f7fa;padding-bottom:7px}
.gdsp-specs strong{font-weight:600;text-align:right}
.gdsp-desc{color:#475569;font-size:.95em;line-height:1.65;margin:18px 0 0;padding-top:16px;border-top:1px solid #f1f5f9}
.gdsp-sec-h{display:flex;justify-content:space-between;align-items:baseline;padding:16px 20px;border-bottom:1px solid #f1f5f9}
.gdsp-sec-h strong{font-size:1.02em;font-weight:600;color:#0f172a}
.gdsp-pad{padding:16px 20px}
.gdsp-listhead{padding:16px 22px;border-bottom:1px solid #f1f5f9;background:#f8fafc;border-radius:14px 14px 0 0}
.gdsp-sort{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.gdsp-sort a{display:inline-block;padding:5px 12px;border-radius:20px;font-size:.78em;font-weight:600;color:#64748b;text-decoration:none;border:1px solid #e2e8f0;background:#fff;transition:all .15s}
.gdsp-sort a:hover{border-color:#93c5fd;color:#1e40af;background:#eff6ff}
.gdsp-sort a.gdsp-sort--active{background:#1e40af;color:#fff;border-color:#1e40af}
@media (max-width:768px){
	.gdsp-wrap{padding:10px}
	.gdsp-main{padding:16px}
	.gdsp-grid{grid-template-columns:1fr;gap:20px}
	.gdsp-specs{grid-template-columns:1fr}
	.gdsp-buy-cta{margin-left:0;width:100%}
	.gdsp-buy-btn{display:block;text-align:center}
}
@media (max-width:600px){
	.gdsp-offers-table{min-width:0 !important}
	.gdsp-col-stock,.gdsp-col-cond{display:none}
}

/* State-restriction banner + clickable chips + popup. Scoped under
   .gdsp-restrict; mobile-friendly. No inline JS with template $-vars. */
.gdsp-restrict{position:relative;margin:0 0 16px}
.gdsp-restrict__banner{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:8px 12px;border-radius:8px;background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;font-weight:600;font-size:.88em;line-height:1.4}
.gdsp-restrict__icon{flex:0 0 auto;font-size:1em}
.gdsp-restrict__label{flex:0 1 auto}
.gdsp-restrict__chips{display:inline-flex;gap:6px;flex-wrap:wrap;align-items:center}
.gdsp-restrict__chip{display:inline-flex;align-items:center;justify-content:center;min-width:40px;padding:5px 11px;border:1px solid #f87171;background:#fff;color:#991B1B;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:1em;font-weight:700;line-height:1.2;cursor:pointer;transition:background .12s,color .12s,border-color .12s}
.gdsp-restrict__chip:hover,.gdsp-restrict__chip:focus{background:#991B1B;color:#fff;border-color:#7f1d1d;outline:none}
.gdsp-restrict__chip:focus-visible{box-shadow:0 0 0 2px #fecaca}
.gdsp-restrict__chip--roster{border-color:#dc2626}
.gdsp-restrict__chip--capacity{border-color:#f97316;color:#7c2d12}
.gdsp-restrict__chip--capacity:hover,.gdsp-restrict__chip--capacity:focus{background:#7c2d12;color:#fff;border-color:#7c2d12}
.gdsp-restrict__chip--override{border-color:#6366f1;color:#3730a3}
.gdsp-restrict__chip--override:hover,.gdsp-restrict__chip--override:focus{background:#3730a3;color:#fff;border-color:#3730a3}
.gdsp-restrict__popup{position:absolute;z-index:60;background:#fff;border:1px solid #cbd5e1;border-radius:10px;box-shadow:0 12px 36px rgba(15,23,42,.18);padding:14px 16px;max-width:340px;font-size:13px;line-height:1.5;color:#1e293b}
.gdsp-restrict__popup[hidden]{display:none}
.gdsp-restrict__close{position:absolute;top:6px;right:8px;background:transparent;border:none;font-size:1.5em;line-height:1;color:#94a3b8;cursor:pointer;padding:0;width:24px;height:24px}
.gdsp-restrict__close:hover,.gdsp-restrict__close:focus{color:#0f172a;outline:none}
.gdsp-restrict__pop-title{margin:0 22px 6px 0;font-size:1em;font-weight:700;color:#0f172a}
.gdsp-restrict__pop-reason{margin:0 0 6px;color:#334155}
.gdsp-restrict__pop-citation{margin:0 0 6px;color:#475569;font-size:.9em}
.gdsp-restrict__pop-citation strong{color:#1e293b;font-weight:600}
.gdsp-restrict__pop-pin{margin:6px 0;padding:8px 10px;background:#fff7ed;border:1px solid #fdba74;border-radius:6px;color:#7c2d12;font-size:.88em}
.gdsp-restrict__pop-exemption{margin:8px 0 6px;padding:8px 10px;background:#fefce8;border:1px solid #fde68a;border-radius:6px;color:#713f12;font-size:.85em;line-height:1.5;white-space:pre-line}
.gdsp-restrict__pop-exemption-label{display:block;margin-bottom:4px;font-size:.72em;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#854d0e}
.gdsp-restrict__pop-disclaimer{margin:8px 0 0;padding-top:8px;border-top:1px dashed #e2e8f0;color:#64748b;font-size:.8em;font-style:italic;line-height:1.4}
.gdsp-advisory{position:relative;margin:0 0 16px}
.gdsp-advisory__banner{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:8px 12px;border-radius:8px;background:#FEF3C7;border:1px solid #FCD34D;color:#78350F;font-weight:600;font-size:.88em;line-height:1.4}
.gdsp-advisory__icon{flex:0 0 auto;font-size:1em}
.gdsp-advisory__label{flex:0 1 auto}
.gdsp-advisory__chips{display:inline-flex;gap:6px;flex-wrap:wrap;align-items:center}
.gdsp-advisory__chip{display:inline-flex;align-items:center;justify-content:center;min-width:40px;padding:5px 11px;border:1px solid #F59E0B;background:#fff;color:#78350F;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:1em;font-weight:700;line-height:1.2;cursor:pointer;transition:background .12s,color .12s,border-color .12s}
.gdsp-advisory__chip:hover,.gdsp-advisory__chip:focus{background:#78350F;color:#fff;border-color:#78350F;outline:none}
.gdsp-advisory__chip:focus-visible{box-shadow:0 0 0 2px #FDE68A}
.gdsp-advisory__popup{position:absolute;z-index:60;background:#fff;border:1px solid #FCD34D;border-radius:10px;box-shadow:0 12px 36px rgba(120,53,15,.18);padding:14px 16px;max-width:380px;font-size:13px;line-height:1.5;color:#1e293b}
.gdsp-advisory__popup[hidden]{display:none}
.gdsp-advisory__close{position:absolute;top:6px;right:8px;background:transparent;border:none;font-size:1.5em;line-height:1;color:#94a3b8;cursor:pointer;padding:0;width:24px;height:24px}
.gdsp-advisory__close:hover,.gdsp-advisory__close:focus{color:#0f172a;outline:none}
.gdsp-advisory__pop-title{margin:0 22px 6px 0;font-size:1em;font-weight:700;color:#78350F}
.gdsp-advisory__pop-reason{margin:0 0 6px;color:#334155;white-space:pre-line}
.gdsp-advisory__pop-citation{margin:0 0 6px;color:#475569;font-size:.9em}
.gdsp-advisory__pop-citation strong{color:#1e293b;font-weight:600}
.gdsp-advisory__pop-disclaimer{margin:8px 0 0;padding-top:8px;border-top:1px dashed #e2e8f0;color:#64748b;font-size:.8em;font-style:italic;line-height:1.4}
.gdsp-advisory__ship-note{display:block;margin:2px 0 0;font-size:.75em;font-weight:500;color:#78350F;opacity:.85}
@media (max-width:600px){
	.gdsp-restrict__popup{max-width:calc(100vw - 40px);left:8px !important;right:8px}
}
/* v1.0.82 — Prices / Reviews tab shell. Prices tab wraps the full
   pre-existing offers + chart card block untouched; Reviews tab
   renders {$reviewsHtml} from gdreviews' shared renderSection(). */
.gdsp-tabs{margin-top:16px}
.gdsp-tabnav{display:flex;gap:0;border-bottom:2px solid #e5e7eb;margin-bottom:14px}
.gdsp-tab{padding:10px 18px;font-weight:600;color:#64748b;text-decoration:none;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color .15s,border-color .15s;cursor:pointer;background:none;border-left:none;border-right:none;border-top:none;font-size:1em;font-family:inherit}
.gdsp-tab:hover{color:#0f172a}
.gdsp-tab--active{color:#0f172a;border-bottom-color:#0f172a}
.gdsp-tab .gdsp-tab-count{color:#94a3b8;font-weight:500;margin-left:4px;font-size:.9em}
.gdsp-tab--active .gdsp-tab-count{color:#64748b}
.gdsp-tabpanel{display:none}
.gdsp-tabpanel--active{display:block}
</style>
<div class="gdsp-wrap">
	<input type="checkbox" id="gdsp-zoom" class="gdsp-zoom-cb" aria-hidden="true">

	<a href="{$backUrl}" class="gdsp-back">&larr; {lang="gdsearch_back_to_results"}</a>

	<div class="gdsp-card gdsp-main">
		<div class="gdsp-grid">

			<div class="gdsp-rail">
				{{if $product['image_url']}}
				<label for="gdsp-zoom" class="gdsp-imgbox" title="Click to enlarge">
					<img src="{$product['image_url']}" alt="{$product['title']}">
				</label>
				{{else}}
				<div class="gdsp-noimg">&#128230;</div>
				{{endif}}

				{{if $alertLoggedIn}}
				<button type="button" class="gd-alert-trigger gdsp-action gdsp-action--amber gdsp-action--first"
					data-upc="{$product['upc']}"
					data-set-url="{$alertSetUrl}"
					data-cancel-url="{$alertCancelUrl}"
					data-csrf="{$alertCsrfKey}"
					data-login-url="{$alertLoginUrl}"
					data-current="{{if $alertCurrent !== null}}{expression="number_format( (float) $alertCurrent, 2, '.', '' )"}{{endif}}"
					data-threshold="{{if $alertThreshold !== null}}{expression="number_format( (float) $alertThreshold, 2, '.', '' )"}{{endif}}">
					<span class="gd-alert-trigger-label">{{if $alertThreshold !== null}}&#128276; Alert: {expression="'$' . number_format( (float) $alertThreshold, 2 )"}{{else}}&#128276; Set Price Alert{{endif}}</span>
				</button>
				{{else}}
				<a href="{$alertLoginUrl}" class="gdsp-action gdsp-action--amber gdsp-action--first">&#128276; Log in for price alert</a>
				{{endif}}

				<button type="button" class="gd-wish-trigger gdsp-action {{if $wishlisted}}ipsButton--positive{{endif}}"
					data-upc="{$product['upc']}"
					data-add-url="{$wishAddUrl}"
					data-remove-url="{$wishRemoveUrl}"
					data-login-url="{$wishLoginUrl}"
					data-csrf="{$wishCsrfKey}"
					data-saved="{{if $wishlisted}}1{{endif}}"
					data-logged-in="{{if $wishLoggedIn}}1{{else}}0{{endif}}">
					<span class="gd-wish-heart">{{if $wishlisted}}&#9829;{{else}}&#9825;{{endif}}</span>
					<span class="gd-wish-label">{{if $wishlisted}}Saved to Wishlist{{else}}Save to Wishlist{{endif}}</span>
				</button>

				<button type="button" class="gd-compare-trigger gdsp-action"
					data-upc="{$product['upc']}"
					data-title="{$product['title']}"
					data-image="{$product['image_url']}"
					data-compare-url="{expression="(string) \IPS\Http\Url::internal( 'app=gdsearch&module=search&controller=results&do=compare', 'front' )"}">
					<span class="gd-compare-label">&#8646; Add to Compare</span>
				</button>

				<button type="button" class="gd-report-trigger gdsp-action gdsp-action--report"
					data-upc="{$product['upc']}" data-report-url="{$reportUrl}" data-login-url="{$reportLoginUrl}" data-csrf="{$reportCsrfKey}"
					data-logged-in="{{if $reportLoggedIn}}1{{else}}0{{endif}}">&#9873; Report an issue</button>
			</div>

			<div class="gdsp-info">
				{{if $product['brand']}}<div class="gdsp-kick">{$product['brand']}</div>{{endif}}
				<h1 class="gdsp-title">{$product['title']}</h1>

				<div class="gdsp-badges">
					{{if $categoryName}}<span class="ipsBadge ipsBadge--neutral">{$categoryName}</span>{{endif}}
					{{if $product['requires_ffl']}}<span class="ipsBadge ipsBadge--warning">{lang="gdsearch_requires_ffl"}</span>{{endif}}
					{{if $product['nfa_item']}}<span class="ipsBadge ipsBadge--negative">{lang="gdsearch_nfa_item"}</span>{{endif}}
					{{if $product['is_ammo']}}<span class="ipsBadge ipsBadge--neutral">Ammo</span>{{endif}}
				</div>

				{{if !empty($advisoryRows)}}
				<div class="gdsp-advisory" role="region" aria-label="Buyer Permit Advisories">
					<div class="gdsp-advisory__banner">
						<span class="gdsp-advisory__icon" aria-hidden="true">&#9432;</span>
						<span class="gdsp-advisory__label">
							Buyer permit / eligibility card required in:
							<span class="gdsp-advisory__ship-note">This item can ship. The buyer must meet a state permit/training requirement at the FFL.</span>
						</span>
						<span class="gdsp-advisory__chips">
							{{foreach $advisoryRows as $ar}}
							<button type="button" class="gdsp-advisory__chip"
								data-state="{$ar['state']}"
								data-statename="{$ar['state_name']}"
								data-reason="{$ar['reason']}"
								data-citation="{$ar['citation']}"
								aria-haspopup="dialog"
								aria-label="{$ar['state_name']} buyer permit advisory"
							>{$ar['state']}</button>
							{{endforeach}}
						</span>
					</div>
					<div class="gdsp-advisory__popup" role="dialog" aria-modal="false" aria-hidden="true" hidden>
						<button type="button" class="gdsp-advisory__close" aria-label="Close">&times;</button>
						<h3 class="gdsp-advisory__pop-title"></h3>
						<p class="gdsp-advisory__pop-reason"></p>
						<p class="gdsp-advisory__pop-citation" hidden><strong>Citation:</strong> <span></span></p>
						<p class="gdsp-advisory__pop-disclaimer">This is a BUYER requirement — not a sale prohibition. The item can ship to your FFL; the purchaser completes the permit / eligibility step there. Verify current requirements with the receiving dealer before purchase.</p>
					</div>
				</div>
				{{endif}}

				{{if !empty($restrictionRows)}}
				<div class="gdsp-restrict" role="region" aria-label="State Restrictions">
					<div class="gdsp-restrict__banner">
						<span class="gdsp-restrict__icon" aria-hidden="true">&#9888;</span>
						<span class="gdsp-restrict__label">State Restricted &mdash; cannot ship to:</span>
						<span class="gdsp-restrict__chips">
							{{foreach $restrictionRows as $rr}}
							<button type="button" class="gdsp-restrict__chip gdsp-restrict__chip--{$rr['type']}"
								data-state="{$rr['state']}"
								data-statename="{$rr['state_name']}"
								data-reason="{$rr['reason']}"
								data-citation="{$rr['citation']}"
								data-exemption="{expression="isset($rr['exemption_note']) ? $rr['exemption_note'] : ''"}"
								data-type="{$rr['type']}"
								data-ftype="{expression="isset($rr['firearm_type']) ? $rr['firearm_type'] : ''"}"
								aria-haspopup="dialog"
								aria-label="{$rr['state_name']} restriction details"
							>{$rr['state']}</button>
							{{endforeach}}
						</span>
					</div>
					<div class="gdsp-restrict__popup" role="dialog" aria-modal="false" aria-hidden="true" hidden>
						<button type="button" class="gdsp-restrict__close" aria-label="Close">&times;</button>
						<h3 class="gdsp-restrict__pop-title"></h3>
						<p class="gdsp-restrict__pop-reason"></p>
						<p class="gdsp-restrict__pop-citation" hidden><strong>Citation:</strong> <span></span></p>
						<p class="gdsp-restrict__pop-pin" hidden>If the restriction is due to magazine capacity, this item may still be transferable if the receiving FFL pins or blocks the magazine to the state-legal capacity before transfer. Confirm with the receiving dealer.</p>
						<div class="gdsp-restrict__pop-exemption" hidden><span class="gdsp-restrict__pop-exemption-label">Exemption note</span><span class="gdsp-restrict__pop-exemption-body"></span></div>
						<p class="gdsp-restrict__pop-disclaimer">Restrictions are provided as guidance and may not reflect the most current law; verify before purchase.</p>
					</div>
				</div>
				{{endif}}

				{{if $product['total_min_price'] !== null && (float) $product['total_min_price'] > 0}}
				<div class="gdsp-buy">
					<div>
						<div class="gdsp-buy-lbl">{lang="gdsearch_best_price"}</div>
						<div class="gdsp-buy-amt">${expression="number_format((float)$product['total_min_price'],2)"}</div>
						<div class="gdsp-buy-meta">{lang="gdsearch_across"} {expression="count($listings)"} {lang="gdsearch_dealers"}{{if $product['msrp'] && (float)$product['msrp'] > (float)$product['total_min_price']}} &middot; MSRP ${expression="number_format((float)$product['msrp'],2)"} &middot; <b>{lang="gdsearch_save"} {expression="round( 100 - ( (float)$product['total_min_price'] / (float)$product['msrp'] * 100 ) )"}%</b>{{endif}}</div>
					</div>
					<div class="gdsp-buy-cta"><a href="#gdsp-listings" class="gdsp-buy-btn">{lang="gdsearch_view_deals"} &darr;</a></div>
				</div>
				{{else}}
				<div class="gdsp-buy">
					<div>
						<div class="gdsp-buy-lbl" style="color:#94a3b8">{lang="gdsearch_price"}</div>
						<div class="gdsp-buy-meta" style="font-size:.95em;margin-top:4px">{lang="gdsearch_no_listings"}{{if $product['msrp']}} &middot; MSRP ${expression="number_format((float)$product['msrp'],2)"}{{endif}}</div>
					</div>
				</div>
				{{endif}}

				<div class="gdsp-spec-h">Specifications</div>
				<div class="gdsp-specs">
					{{if $product['brand']}}<div><span style="color:#94a3b8">Brand</span> <strong>{$product['brand']}</strong></div>{{endif}}
					{{if $product['upc']}}<div><span style="color:#94a3b8">UPC</span> <strong>{$product['upc']}</strong></div>{{endif}}
					{{if $product['mpn']}}<div><span style="color:#94a3b8">{lang="gdsearch_mpn"}</span> <strong>{$product['mpn']}</strong></div>{{endif}}
					{{if $product['caliber']}}<div><span style="color:#94a3b8">{lang="gdsearch_caliber"}</span> <strong>{$product['caliber']}</strong></div>{{endif}}
					{{if $product['bullet_weight']}}<div><span style="color:#94a3b8">Grain</span> <strong>{$product['bullet_weight']}</strong></div>{{endif}}
					{{if $product['bullet_type']}}<div><span style="color:#94a3b8">Bullet Type</span> <strong>{$product['bullet_type']}</strong></div>{{endif}}
					{{if $product['casing_material']}}<div><span style="color:#94a3b8">Casing</span> <strong>{$product['casing_material']}</strong></div>{{endif}}
					{{if $product['rounds_per_box']}}<div><span style="color:#94a3b8">Rounds/Box</span> <strong>{$product['rounds_per_box']}</strong></div>{{endif}}
					{{if $product['muzzle_velocity']}}<div><span style="color:#94a3b8">Muzzle Velocity</span> <strong>{expression="trim( preg_replace( '/\\s*fps\\s*/i', '', (string) $product['muzzle_velocity'] ) )"} fps</strong></div>{{endif}}
					{{if $product['muzzle_energy']}}<div><span style="color:#94a3b8">Muzzle Energy</span> <strong>{$product['muzzle_energy']} ft&middot;lbs</strong></div>{{endif}}
					{{if $product['action_type']}}<div><span style="color:#94a3b8">{lang="gdsearch_action_type"}</span> <strong>{$product['action_type']}</strong></div>{{endif}}
					{{if $product['capacity']}}<div><span style="color:#94a3b8">{lang="gdsearch_capacity"}</span> <strong>{$product['capacity']}</strong></div>{{endif}}
					{{if $product['barrel_length']}}<div><span style="color:#94a3b8">{lang="gdsearch_barrel_length"}</span> <strong>{$product['barrel_length']}</strong></div>{{endif}}
					{{if $product['overall_length']}}<div><span style="color:#94a3b8">{lang="gdsearch_overall_length"}</span> <strong>{$product['overall_length']}</strong></div>{{endif}}
					{{if $product['weight_lbs']}}<div><span style="color:#94a3b8">{lang="gdsearch_weight"}</span> <strong>{$product['weight_lbs']} lbs</strong></div>{{endif}}
					{{if $product['msrp']}}<div><span style="color:#94a3b8">{lang="gdsearch_msrp"}</span> <strong>${expression="number_format((float)$product['msrp'],2)"}</strong></div>{{endif}}
				</div>

				{{if !empty($product['description_full'])}}
				<p class="gdsp-desc">{expression="nl2br( htmlspecialchars( $product['description_full'] ) )" raw="1"}</p>
				{{elseif $product['description']}}
				<p class="gdsp-desc">{$product['description']}</p>
				{{endif}}
			</div>
		</div>
	</div>

	<div class="gdsp-card">
		<div class="gdsp-sec-h">
			<strong>Price History <span style="font-weight:400;color:#6B7280;font-size:.85em">(past 12 months)</span></strong>
			{{if $priceAllTimeLow !== null}}<span style="font-size:.85em;color:#6B7280">All-time low: <strong style="color:#1E40AF">{expression="'$' . number_format( (float) $priceAllTimeLow, 2 )"}</strong></span>{{endif}}
		</div>
		<div class="gdsp-pad">
			<div class="gd-pricechart" data-points='{$priceChartJson|raw}' style="position:relative;width:100%">
				{$priceChartSvg|raw}
				<div class="gd-pc-tip" style="position:absolute;display:none;pointer-events:none;background:#111827;color:#fff;font-size:12px;line-height:1.35;padding:6px 9px;border-radius:6px;white-space:nowrap;z-index:5;box-shadow:0 2px 8px rgba(0,0,0,.2)"></div>
			</div>
		</div>
	</div>

	<div class="gdsp-tabs" id="gdsp-tabs">
		<div class="gdsp-tabnav" role="tablist">
			<button type="button" class="gdsp-tab gdsp-tab--active" data-tab="prices" role="tab" aria-selected="true">{lang="gdsearch_tab_prices"}</button>
			<button type="button" class="gdsp-tab" data-tab="reviews" role="tab" aria-selected="false">{lang="gdsearch_tab_reviews"}<span class="gdsp-tab-count">({$reviewCount})</span></button>
		</div>

	<div class="gdsp-tabpanel gdsp-tabpanel--active" id="gdsp-tab-prices" role="tabpanel">
	<div class="gdsp-card" id="gdsp-listings" style="overflow:hidden">
		<div class="gdsp-listhead">
			<h2 style="margin:0;font-size:1.05em;font-weight:600;color:#0f172a">{lang="gdsearch_price_comparison"} <span style="font-weight:400;color:#94a3b8;font-size:0.9em">({expression="count($listings)"} {lang="gdsearch_dealers"})</span></h2>
			{{if count($listings) > 1}}
			<div class="gdsp-sort">
				{{foreach $sortOptions as $sKey => $sLabel}}
				<a href="{$sortBaseUrl}&amp;offers_sort={$sKey}#gdsp-listings" class="{{if $offersSort === $sKey}}gdsp-sort--active{{endif}}">{$sLabel}</a>
				{{endforeach}}
			</div>
			{{endif}}
		</div>
		{{if count($listings) === 0}}
		<div style="padding:40px;text-align:center;color:#94a3b8">
			<p style="margin:0">{lang="gdsearch_no_listings"}</p>
		</div>
		{{else}}
		<div style="overflow-x:auto">
		<table class="gdsp-offers-table" style="width:100%;border-collapse:collapse;min-width:560px">
			<thead>
				<tr style="background:#f8fafc;font-size:0.72em;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8">
					<th style="padding:11px 16px;text-align:left">{lang="gdsearch_dealer"}</th>
					<th style="padding:11px 16px;text-align:right">{lang="gdsearch_price"}</th>
					<th style="padding:11px 16px;text-align:center">{lang="gdsearch_shipping"}</th>
					<th class="gdsp-col-stock" style="padding:11px 16px;text-align:center">{lang="gdsearch_stock"}</th>
					<th class="gdsp-col-cond" style="padding:11px 16px;text-align:center">{lang="gdsearch_condition"}</th>
					<th style="padding:11px 16px;text-align:center"></th>
				</tr>
			</thead>
			<tbody>
				{{foreach $listings as $i => $listing}}
				<tr style="border-top:1px solid #f1f5f9{{if $listing['is_lowest']}};background:#f0fdf4{{endif}}">
					<td style="padding:14px 16px">
						<div style="font-weight:600;font-size:0.92em;color:#0f172a">{$listing['dealer_name']}{{if $listing['is_lowest']}} <span class="ipsBadge ipsBadge--positive" style="font-size:0.66em;vertical-align:middle">{lang="gdsearch_best_price"}</span>{{endif}}</div>
						<div style="margin-top:5px">
							<button type="button" class="gd-listing-report-trigger" data-upc="{$product['upc']}" data-dealer-id="{$listing['dealer_id']}" data-dealer-name="{$listing['dealer_name']}" data-logged-in="{{if $listingReportLoggedIn}}1{{else}}0{{endif}}" style="border:none;background:none;color:#cbd5e1;font-size:.74em;cursor:pointer;padding:0">&#9873; Report</button>
						</div>
					</td>
					<td style="padding:14px 16px;text-align:right">
						<div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:1.1em;color:{{if $listing['is_lowest']}}#16a34a{{else}}#0f172a{{endif}}">${expression="number_format((float)$listing['price'],2)"}</div>
						{{if isset($listing['total_cost']) && $listing['total_cost'] !== null}}
						<div style="font-family:'JetBrains Mono',monospace;font-size:0.75em;color:#64748b;margin-top:2px">Total ${expression="number_format((float)$listing['total_cost'],2)"} <span style="color:#94a3b8">w/ ship</span></div>
						{{endif}}
					</td>
					<td style="padding:14px 16px;text-align:center;font-size:0.85em">
						{{if isset($listing['shipping_info']) && $listing['shipping_info'] !== ''}}
							{{if $listing['shipping_info'] === 'Free shipping'}}
							<span style="color:#16a34a;font-weight:600">{$listing['shipping_info']}</span>
							{{else}}
							<span style="color:#64748b">{$listing['shipping_info']}</span>
							{{endif}}
						{{else}}
						<span style="color:#cbd5e1">&mdash;</span>
						{{endif}}
					</td>
					<td class="gdsp-col-stock" style="padding:14px 16px;text-align:center">
						{{if $listing['in_stock']}}
						<span class="ipsBadge ipsBadge--positive">{lang="gdsearch_in_stock"}{{if $listing['stock_qty'] > 0}} ({$listing['stock_qty']}){{endif}}</span>
						{{else}}
						<span class="ipsBadge ipsBadge--neutral">{lang="gdsearch_out_of_stock"}</span>
						{{endif}}
					</td>
					<td class="gdsp-col-cond" style="padding:14px 16px;text-align:center;font-size:0.85em;color:#64748b">
						{expression="ucfirst($listing['condition'])"}
					</td>
					<td style="padding:14px 16px;text-align:center">
						{{if $listing['listing_url']}}
						<a href="{expression="(string) \IPS\Http\Url::internal( 'app=gddealer&module=dealers&controller=click&d=' . (int) $listing['dealer_id'] . '&u=' . urlencode( $product['upc'] ), 'front', 'dealers_click' )"}" target="_blank" rel="nofollow noopener sponsored" class="ipsButton ipsButton--primary ipsButton--small">{lang="gdsearch_buy_now"}</a>
						{{else}}
						<a href="{url="app=gddealer&module=dealers&controller=profile&dealer_slug={$listing['dealer_slug']}"}" class="ipsButton ipsButton--secondary ipsButton--small">{lang="gdsearch_view_dealer"}</a>
						{{endif}}
					</td>
				</tr>
				{{endforeach}}
			</tbody>
		</table>
		</div>
		{{endif}}
	</div>
	</div><!-- /gdsp-tab-prices -->

	<div class="gdsp-tabpanel" id="gdsp-tab-reviews" role="tabpanel">
		<div class="gdsp-card"><div class="gdsp-pad" style="padding:20px">
			{{if $reviewsHtml}}
				{$reviewsHtml|raw}
			{{else}}
				<div style="color:#64748b;font-style:italic;padding:12px 0">{lang="gdreviews_no_reviews"}</div>
			{{endif}}
		</div></div>
	</div><!-- /gdsp-tab-reviews -->
	</div><!-- /gdsp-tabs -->

	<script>
	(function(){
		var tabs = document.getElementById('gdsp-tabs');
		if ( !tabs ) return;
		var buttons = tabs.querySelectorAll('.gdsp-tab');
		var panels  = tabs.querySelectorAll('.gdsp-tabpanel');
		function activate( key ) {
			buttons.forEach(function(b){
				var on = b.getAttribute('data-tab') === key;
				b.classList.toggle('gdsp-tab--active', on);
				b.setAttribute('aria-selected', on ? 'true' : 'false');
			});
			panels.forEach(function(p){
				p.classList.toggle('gdsp-tabpanel--active', p.id === 'gdsp-tab-' + key);
			});
		}
		buttons.forEach(function(b){
			b.addEventListener('click', function(){ activate(b.getAttribute('data-tab')); });
		});
		if ( location.hash === '#gdsp-reviews' || location.hash === '#gdsp-tab-reviews' ) { activate('reviews'); }
		var viewDeals = document.querySelector('.gdsp-buy-btn');
		if ( viewDeals ) viewDeals.addEventListener('click', function(){ activate('prices'); });
	})();
	</script>

	{{if $alertLoggedIn}}
	<div class="gd-alert-modal" id="gdAlertModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(15,23,42,.5);align-items:center;justify-content:center;padding:16px">
		<div style="background:#fff;border-radius:12px;max-width:420px;width:100%;padding:24px;box-shadow:0 10px 40px rgba(0,0,0,.25);box-sizing:border-box">
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
				<strong style="font-size:1.1em">Price Drop Alert</strong>
				<button type="button" class="gd-alert-close" style="border:none;background:none;font-size:1.5em;line-height:1;cursor:pointer;color:#94a3b8">&times;</button>
			</div>
			<p class="gd-alert-current" style="margin:0 0 14px;color:#64748b;font-size:.9em;line-height:1.45"></p>
			<div style="display:flex;gap:8px;align-items:center">
				<span style="color:#64748b">$</span>
				<input type="number" min="0" step="0.01" class="gd-alert-input ipsInput ipsInput--text" style="flex:1" placeholder="Your price">
				<button type="button" class="gd-alert-save ipsButton ipsButton--primary">Notify me</button>
			</div>
			<div style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;min-height:24px">
				<button type="button" class="gd-alert-remove ipsButton ipsButton--soft ipsButton--small" style="display:none">Remove alert</button>
				<span class="gd-alert-msg" style="font-size:.85em;color:#1E40AF"></span>
			</div>
		</div>
	</div>
	{{endif}}

	<div class="gd-report-modal" id="gdReportModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(15,23,42,.5);align-items:center;justify-content:center;padding:16px">
		<div style="background:#fff;border-radius:14px;max-width:440px;width:100%;padding:24px;box-shadow:0 20px 50px -12px rgba(0,0,0,.4)">
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
				<strong style="font-size:1.1em;color:#0f172a">Report an issue</strong>
				<button type="button" class="gd-report-close" style="border:none;background:none;font-size:1.4em;cursor:pointer;color:#94a3b8;line-height:1">&times;</button>
			</div>
			<div class="gd-report-form">
				<label style="display:flex;gap:8px;align-items:flex-start;margin-bottom:10px;cursor:pointer">
					<input type="radio" name="gd_report_reason" value="data" checked style="margin-top:3px">
					<span><strong>Incorrect price or product data</strong><br><span style="color:#64748b;font-size:.88em">Wrong price, broken listing, mismatched product, etc.</span></span>
				</label>
				<label style="display:flex;gap:8px;align-items:flex-start;margin-bottom:14px;cursor:pointer">
					<input type="radio" name="gd_report_reason" value="content" style="margin-top:3px">
					<span><strong>Inappropriate or abusive content</strong><br><span style="color:#64748b;font-size:.88em">Offensive text, spam, or policy violations.</span></span>
				</label>
				<textarea class="gd-report-details ipsInput ipsInput--text" rows="3" placeholder="Add any details (optional)" style="width:100%;box-sizing:border-box"></textarea>
			</div>
			<p class="gd-report-msg" style="color:#15803d;font-size:.9em;margin:10px 0 0"></p>
			<div style="margin-top:16px;text-align:right">
				<button type="button" class="gd-report-submit ipsButton ipsButton--primary">Submit report</button>
			</div>
		</div>
	</div>

	<div class="gd-listing-report-modal" id="gdListingReportModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(15,23,42,.5);align-items:center;justify-content:center;padding:16px">
		<div style="background:#fff;border-radius:14px;max-width:460px;width:100%;padding:24px;box-shadow:0 20px 50px -12px rgba(0,0,0,.4)" data-report-url="{$listingReportUrl}" data-csrf="{$listingReportCsrfKey}" data-login-url="{$listingReportLoginUrl}">
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
				<strong style="font-size:1.1em;color:#0f172a">Report this listing</strong>
				<button type="button" class="gd-listing-report-close" style="border:none;background:none;font-size:1.4em;cursor:pointer;color:#94a3b8;line-height:1">&times;</button>
			</div>
			<p class="gd-listing-report-dealer" style="color:#64748b;font-size:.85em;margin:0 0 12px"></p>
			<div class="gd-listing-report-form">
				<label style="display:block;margin-bottom:8px;cursor:pointer"><input type="radio" name="gd_listing_reason" value="wrong_price" checked> Wrong price</label>
				<label style="display:block;margin-bottom:8px;cursor:pointer"><input type="radio" name="gd_listing_reason" value="dead_link"> Dead / broken link</label>
				<label style="display:block;margin-bottom:8px;cursor:pointer"><input type="radio" name="gd_listing_reason" value="false_in_stock"> Out of stock (listed as in stock)</label>
				<label style="display:block;margin-bottom:8px;cursor:pointer"><input type="radio" name="gd_listing_reason" value="wrong_product"> Wrong product / UPC mismatch</label>
				<label style="display:block;margin-bottom:10px;cursor:pointer"><input type="radio" name="gd_listing_reason" value="other"> Other</label>
				<textarea class="gd-listing-report-note ipsInput ipsInput--text" rows="3" placeholder="Add any details (optional)" style="width:100%;box-sizing:border-box"></textarea>
			</div>
			<p class="gd-listing-report-msg" style="color:#15803d;font-size:.9em;margin:10px 0 0"></p>
			<div style="margin-top:16px;text-align:right">
				<button type="button" class="gd-listing-report-submit ipsButton ipsButton--primary">Submit report</button>
			</div>
		</div>
	</div>

	{{if $product['image_url']}}
	<label for="gdsp-zoom" class="gdsp-lightbox">
		<span class="gdsp-lightbox-x" aria-hidden="true">&times;</span>
		<img src="{$product['image_url']}" alt="{$product['title']}">
	</label>
	{{endif}}
</div>
