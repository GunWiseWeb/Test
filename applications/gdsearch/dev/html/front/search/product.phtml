<ips:template parameters="$product, $listings, $categoryName, $backUrl, $restrictedStatesStr, $priceChartSvg, $priceChartJson, $priceAllTimeLow" />
<style>
.gdsp-wrap { width:100%; margin:0; padding:16px; box-sizing:border-box }
.gdsp-top { display:grid; grid-template-columns:420px 1fr; gap:36px }
.gdsp-imgbox { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:20px; text-align:center }
.gdsp-imgbox img { max-width:100%; max-height:400px; object-fit:contain }
.gdsp-noimg { background:#f1f5f9; border-radius:10px; height:360px; display:flex; align-items:center; justify-content:center; color:#cbd5e1; font-size:3em }
.gdsp-specs { display:grid; grid-template-columns:1fr 1fr; gap:14px 28px; font-size:1.08em; line-height:1.5 }
.gdsp-specs strong { font-size:1.02em }
@media (max-width:768px) {
	.gdsp-wrap { padding:10px }
	.gdsp-top { grid-template-columns:1fr; gap:20px }
	.gdsp-specs { grid-template-columns:1fr }
}
</style>
<div class="gdsp-wrap">

	<a href="{$backUrl}" style="display:inline-flex;align-items:center;gap:6px;color:#64748b;text-decoration:none;margin-bottom:20px;font-size:0.9em">&larr; {lang="gdsearch_back_to_results"}</a>

	<div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:28px;margin-bottom:24px;box-shadow:0 1px 3px rgba(15,23,42,0.06)">
		<div class="gdsp-top">
			<div>
				{{if $product['image_url']}}
				<div class="gdsp-imgbox">
					<img src="{$product['image_url']}" alt="{$product['title']}">
				</div>
				{{else}}
				<div class="gdsp-noimg">&#128230;</div>
				{{endif}}

			</div>

			<div>
				{{if $product['brand']}}<div style="color:#64748b;font-size:0.85em;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px">{$product['brand']}</div>{{endif}}
				<h1 style="margin:0 0 12px;font-size:1.6em;line-height:1.3;color:#0f172a">{$product['title']}</h1>

				<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px">
					{{if $categoryName}}<span class="ipsBadge ipsBadge--neutral">{$categoryName}</span>{{endif}}
					{{if $product['requires_ffl']}}<span class="ipsBadge ipsBadge--warning">{lang="gdsearch_requires_ffl"}</span>{{endif}}
					{{if $product['nfa_item']}}<span class="ipsBadge ipsBadge--negative">{lang="gdsearch_nfa_item"}</span>{{endif}}
					{{if $product['is_ammo']}}<span class="ipsBadge ipsBadge--neutral">Ammo</span>{{endif}}
				</div>

				{{if $restrictedStatesStr}}
				<div style="display:inline-flex;align-items:center;gap:8px;margin:0 0 16px;padding:8px 12px;border-radius:6px;background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;font-weight:600;font-size:0.88em">
					<span aria-hidden="true">&#9888;</span>
					<span>State Restricted &mdash; cannot ship to: {$restrictedStatesStr}</span>
				</div>
				{{endif}}

				<div style="border-top:1px solid #f1f5f9;padding-top:16px">
					<div style="font-size:0.92em;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;margin-bottom:14px">Specifications</div>
					<div class="gdsp-specs">
						{{if $product['brand']}}<div><span style="color:#94a3b8">Brand:</span> <strong>{$product['brand']}</strong></div>{{endif}}
						{{if $product['upc']}}<div><span style="color:#94a3b8">UPC:</span> <strong>{$product['upc']}</strong></div>{{endif}}
						{{if $product['mpn']}}<div><span style="color:#94a3b8">{lang="gdsearch_mpn"}:</span> <strong>{$product['mpn']}</strong></div>{{endif}}
						{{if $product['caliber']}}<div><span style="color:#94a3b8">{lang="gdsearch_caliber"}:</span> <strong>{$product['caliber']}</strong></div>{{endif}}
						{{if $product['bullet_weight']}}<div><span style="color:#94a3b8">Grain:</span> <strong>{$product['bullet_weight']}</strong></div>{{endif}}
						{{if $product['bullet_type']}}<div><span style="color:#94a3b8">Bullet Type:</span> <strong>{$product['bullet_type']}</strong></div>{{endif}}
						{{if $product['casing_material']}}<div><span style="color:#94a3b8">Casing:</span> <strong>{$product['casing_material']}</strong></div>{{endif}}
						{{if $product['rounds_per_box']}}<div><span style="color:#94a3b8">Rounds/Box:</span> <strong>{$product['rounds_per_box']}</strong></div>{{endif}}
						{{if $product['muzzle_velocity']}}<div><span style="color:#94a3b8">Muzzle Velocity:</span> <strong>{$product['muzzle_velocity']} fps</strong></div>{{endif}}
						{{if $product['muzzle_energy']}}<div><span style="color:#94a3b8">Muzzle Energy:</span> <strong>{$product['muzzle_energy']} ft·lbs</strong></div>{{endif}}
						{{if $product['action_type']}}<div><span style="color:#94a3b8">{lang="gdsearch_action_type"}:</span> <strong>{$product['action_type']}</strong></div>{{endif}}
						{{if $product['capacity']}}<div><span style="color:#94a3b8">{lang="gdsearch_capacity"}:</span> <strong>{$product['capacity']}</strong></div>{{endif}}
						{{if $product['barrel_length']}}<div><span style="color:#94a3b8">{lang="gdsearch_barrel_length"}:</span> <strong>{$product['barrel_length']}</strong></div>{{endif}}
						{{if $product['overall_length']}}<div><span style="color:#94a3b8">{lang="gdsearch_overall_length"}:</span> <strong>{$product['overall_length']}</strong></div>{{endif}}
						{{if $product['weight_lbs']}}<div><span style="color:#94a3b8">{lang="gdsearch_weight"}:</span> <strong>{$product['weight_lbs']} lbs</strong></div>{{endif}}
						{{if $product['msrp']}}<div><span style="color:#94a3b8">{lang="gdsearch_msrp"}:</span> <strong>${expression="number_format((float)$product['msrp'],2)"}</strong></div>{{endif}}
					</div>
				</div>

				{{if $product['description']}}
				<p style="color:#475569;font-size:0.92em;line-height:1.55;margin:16px 0 0">{$product['description']}</p>
				{{endif}}
			</div>
		</div>
	</div>

	<div style="width:100%;background:#fff;margin:24px 0;padding:18px 20px;border:1px solid var(--i-border-color, #e5e7eb);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.04);box-sizing:border-box">
		<div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px">
			<strong style="font-size:1.05em">Price History <span style="font-weight:400;color:#6B7280">(past 12 months)</span></strong>
			{{if $priceAllTimeLow !== null}}<span style="font-size:.9em;color:#6B7280">All-time low: <strong style="color:#1E40AF">{expression="'$' . number_format( (float) $priceAllTimeLow, 2 )"}</strong></span>{{endif}}
		</div>
		<div class="gd-pricechart" data-points='{$priceChartJson|raw}' style="position:relative;width:100%">
			{$priceChartSvg|raw}
			<div class="gd-pc-tip" style="position:absolute;display:none;pointer-events:none;background:#111827;color:#fff;font-size:12px;line-height:1.35;padding:6px 9px;border-radius:6px;white-space:nowrap;z-index:5;box-shadow:0 2px 8px rgba(0,0,0,.2)"></div>
		</div>
	</div>

	<div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,0.06)">
		<div style="padding:16px 24px;border-bottom:1px solid #f1f5f9;background:#f8fafc">
			<h2 style="margin:0;font-size:1.05em;font-weight:700;color:#0f172a">{lang="gdsearch_price_comparison"} <span style="font-weight:400;color:#94a3b8;font-size:0.9em">({expression="count($listings)"} {lang="gdsearch_dealers"})</span></h2>
		</div>
		{{if count($listings) === 0}}
		<div style="padding:40px;text-align:center;color:#94a3b8">
			<p style="margin:0">{lang="gdsearch_no_listings"}</p>
		</div>
		{{else}}
		<div style="overflow-x:auto">
		<table style="width:100%;border-collapse:collapse;min-width:560px">
			<thead>
				<tr style="background:#f8fafc;font-size:0.72em;text-transform:uppercase;letter-spacing:0.05em;color:#94a3b8">
					<th style="padding:11px 16px;text-align:left">{lang="gdsearch_dealer"}</th>
					<th style="padding:11px 16px;text-align:right">{lang="gdsearch_price"}</th>
					<th style="padding:11px 16px;text-align:center">{lang="gdsearch_shipping"}</th>
					<th style="padding:11px 16px;text-align:center">{lang="gdsearch_stock"}</th>
					<th style="padding:11px 16px;text-align:center">{lang="gdsearch_condition"}</th>
					<th style="padding:11px 16px;text-align:center"></th>
				</tr>
			</thead>
			<tbody>
				{{foreach $listings as $i => $listing}}
				<tr style="border-top:1px solid #f1f5f9{{if $i === 0}};background:#f0fdf4{{endif}}">
					<td style="padding:14px 16px">
						<div style="font-weight:600;font-size:0.92em;color:#0f172a">{$listing['dealer_name']}</div>
						{{if $listing['tier'] === 'founding' || $listing['tier'] === 'enterprise' || $listing['tier'] === 'pro'}}
						<span class="ipsBadge ipsBadge--positive" style="font-size:0.7em">{expression="ucfirst($listing['tier'])"}</span>
						{{endif}}
					</td>
					<td style="padding:14px 16px;text-align:right">
						<div style="font-weight:700;font-size:1.1em;color:{{if $i === 0}}#16a34a{{else}}#0f172a{{endif}}">${expression="number_format((float)$listing['price'],2)"}</div>
					</td>
					<td style="padding:14px 16px;text-align:center;font-size:0.85em">
						{{if $listing['free_shipping']}}
						<span style="color:#16a34a;font-weight:600">{lang="gdsearch_free_shipping"}</span>
						{{elseif $listing['shipping_cost']}}
						<span style="color:#64748b">${expression="number_format((float)$listing['shipping_cost'],2)"}</span>
						{{else}}
						<span style="color:#cbd5e1">&mdash;</span>
						{{endif}}
					</td>
					<td style="padding:14px 16px;text-align:center">
						{{if $listing['in_stock']}}
						<span class="ipsBadge ipsBadge--positive">{lang="gdsearch_in_stock"}{{if $listing['stock_qty'] > 0}} ({$listing['stock_qty']}){{endif}}</span>
						{{else}}
						<span class="ipsBadge ipsBadge--neutral">{lang="gdsearch_out_of_stock"}</span>
						{{endif}}
					</td>
					<td style="padding:14px 16px;text-align:center;font-size:0.85em;color:#64748b">
						{expression="ucfirst($listing['condition'])"}
					</td>
					<td style="padding:14px 16px;text-align:center">
						{{if $listing['listing_url']}}
						<a href="{$listing['listing_url']}" target="_blank" rel="nofollow noopener" class="ipsButton ipsButton--primary ipsButton--small">{lang="gdsearch_buy_now"}</a>
						{{else}}
						<a href="{url="app=gddealer&module=dealers&controller=profile&dealer_slug={$listing['dealer_slug']}"}" class="ipsButton ipsButton--secondary ipsButton--small">{lang="gdsearch_view_dealer"}</a>
						{{endif}}
					</td>
				</tr>
				{{endforeach}}
			</tbody>
		</table>
		</div>
		{{endif}}
	</div>
</div>
