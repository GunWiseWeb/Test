<ips:template parameters="$query, $results, $total, $pagination, $filters, $sort, $aggs, $categories, $error, $grainBands, $velocityBands" />
<style>
.gdsr-wrap { width:100%; margin:0; padding:16px; box-sizing:border-box }
.gdsr-layout { display:grid; grid-template-columns:240px 1fr; gap:24px; align-items:start }
.gdsr-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:20px }
.gdsr-card { position:relative; text-decoration:none; color:inherit; display:block; border:1px solid #e2e8f0; border-radius:10px; overflow:hidden; background:#fff; transition:box-shadow 0.15s, transform 0.15s }
.gdsr-cmp { position:absolute; top:8px; right:8px; z-index:3; background:rgba(255,255,255,.96); border:1px solid #e2e8f0; border-radius:7px; padding:4px 10px; font-size:.72em; font-weight:700; color:#1E40AF; cursor:pointer; line-height:1; user-select:none }
.gdsr-cmp:hover { background:#eef2ff; border-color:#c7d2fe }
.gdsr-cmp.ipsButton--positive { background:#dcfce7; color:#15803d; border-color:#bbf7d0 }
.gdsr-card:hover { box-shadow:0 6px 18px -6px rgba(15,23,42,0.18); transform:translateY(-2px) }
.gdsr-thumb { height:220px; background:#f8fafc; display:flex; align-items:center; justify-content:center; padding:12px }
.gdsr-thumb img { max-height:196px; max-width:100%; object-fit:contain }
.gdsr-noimg { height:160px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:#cbd5e1; font-size:2.6em }
.gdsr-side-box { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-bottom:12px }
.gdsr-fh { margin:0 0 10px; font-size:0.78em; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#64748b }
.gdsr-facet-list { max-height:210px; overflow-y:auto; margin:0; padding:0; border:1px solid #e2e8f0; border-radius:8px; background:#fff }
.gdsr-facet-list::-webkit-scrollbar { width:8px }
.gdsr-facet-list::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:8px }
.gdsr-facet-opt { display:flex !important; align-items:center; gap:9px; margin:0 !important; padding:8px 11px !important; border-bottom:1px solid #f1f5f9; font-size:0.86em; line-height:1.3; cursor:pointer; box-sizing:border-box }
.gdsr-facet-opt:last-child { border-bottom:none }
.gdsr-facet-opt:hover { background:#f8fafc }
.gdsr-facet-opt input[type="checkbox"] { margin:0 !important; flex:0 0 auto; width:15px; height:15px }
.gdsr-facet-opt span { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#334155 }
.gdsr-facet-opt em { flex:0 0 auto; font-style:normal; font-size:0.78em; color:#64748b; background:#f1f5f9; border-radius:10px; padding:2px 8px; line-height:1.4 }
@media (max-width:900px) {
	.gdsr-layout { grid-template-columns:1fr }
}
@media (max-width:640px) {
	.gdsr-wrap { padding:10px }
	.gdsr-grid { grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:12px }
	.gdsr-thumb { height:150px; padding:8px }
	.gdsr-thumb img { max-height:134px }
}
</style>
<div class="gdsr-wrap">

	<form method="get" action="{url="app=gdsearch&module=search&controller=results"}" style="margin-bottom:24px">
		<input type="hidden" name="app" value="gdsearch">
		<input type="hidden" name="module" value="search">
		<input type="hidden" name="controller" value="results">
		<div style="display:flex;gap:8px">
			<input type="text" name="q" class="ipsInput ipsInput--text" style="flex:1;font-size:1.1em;padding:12px 16px" value="{$query}" placeholder="{lang="gdsearch_search_placeholder"}">
			<button type="submit" class="ipsButton ipsButton--primary" style="padding:12px 28px">{lang="gdsearch_search_submit"}</button>
		</div>
	</form>

	{{if $error}}
	<div style="background:#fef2f2;border:1px solid #dc2626;border-radius:8px;padding:12px;margin-bottom:16px;color:#dc2626">Search unavailable: {$error}</div>
	{{endif}}

	<div class="gdsr-layout">

		<div>
			<form method="get" action="{url="app=gdsearch&module=search&controller=results"}">
				<input type="hidden" name="app" value="gdsearch">
				<input type="hidden" name="module" value="search">
				<input type="hidden" name="controller" value="results">
				<input type="hidden" name="q" value="{$query}">
				<input type="hidden" name="sort" value="{$sort}">

				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_filter_category"}</h3>
					<select name="category" class="ipsInput ipsInput--select" style="width:100%" onchange="this.form.submit()">
						<option value="">All Categories</option>
						{{foreach $categories as $cat}}
						<option value="{$cat['id']}" {{if $filters['category_id'] === $cat['id']}}selected{{endif}}>{$cat['name']}</option>
						{{endforeach}}
					</select>
				</div>

				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_filter_price"}</h3>
					<div style="display:flex;gap:6px;align-items:center">
						<input type="number" name="min_price" placeholder="Min" class="ipsInput ipsInput--text" style="width:100%" value="{{if $filters['min_price'] > 0}}{$filters['min_price']}{{endif}}">
						<span style="color:#94a3b8">&ndash;</span>
						<input type="number" name="max_price" placeholder="Max" class="ipsInput ipsInput--text" style="width:100%" value="{{if $filters['max_price'] > 0}}{$filters['max_price']}{{endif}}">
					</div>
				</div>

				{{if isset($aggs['brands']['buckets']) and count($aggs['brands']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_brand"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['brands']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="brand[]" value="{$b['key']}" {{if is_array($filters['brand']) and in_array($b['key'], $filters['brand'])}}checked{{endif}}><span>{$b['key']}</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if isset($aggs['calibers']['buckets']) and count($aggs['calibers']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_caliber"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['calibers']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="caliber[]" value="{$b['key']}" {{if is_array($filters['caliber']) and in_array($b['key'], $filters['caliber'])}}checked{{endif}}><span>{$b['key']}</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if isset($aggs['actions']['buckets']) and count($aggs['actions']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_action"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['actions']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="action[]" value="{$b['key']}" {{if is_array($filters['action']) and in_array($b['key'], $filters['action'])}}checked{{endif}}><span>{$b['key']}</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if isset($aggs['capacities']['buckets']) and count($aggs['capacities']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_capacity"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['capacities']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="capacity[]" value="{$b['key']}" {{if is_array($filters['capacity']) and in_array($b['key'], $filters['capacity'])}}checked{{endif}}><span>{$b['key']} rds</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if isset($aggs['casings']['buckets']) and count($aggs['casings']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_casing"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['casings']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="casing[]" value="{$b['key']}" {{if is_array($filters['casing']) and in_array($b['key'], $filters['casing'])}}checked{{endif}}><span>{$b['key']}</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if isset($aggs['bullet_types']['buckets']) and count($aggs['bullet_types']['buckets'])}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_bullet"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $aggs['bullet_types']['buckets'] as $b}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="bullet_type[]" value="{$b['key']}" {{if is_array($filters['bullet_type']) and in_array($b['key'], $filters['bullet_type'])}}checked{{endif}}><span>{$b['key']}</span><em>{$b['doc_count']}</em></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				{{if (isset($aggs['casings']['buckets']) and count($aggs['casings']['buckets'])) or (isset($aggs['bullet_types']['buckets']) and count($aggs['bullet_types']['buckets']))}}
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_grain"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $grainBands as $bandKey => $bandLabel}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="grain[]" value="{$bandKey}" {{if is_array($filters['grain']) and in_array($bandKey, $filters['grain'])}}checked{{endif}}><span>{$bandLabel}</span></label>
						{{endforeach}}
					</div>
				</div>
				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_facet_velocity"}</h3>
					<div class="gdsr-facet-list">
						{{foreach $velocityBands as $bandKey => $bandLabel}}
						<label class="gdsr-facet-opt"><input type="checkbox" name="velocity[]" value="{$bandKey}" {{if is_array($filters['velocity']) and in_array($bandKey, $filters['velocity'])}}checked{{endif}}><span>{$bandLabel}</span></label>
						{{endforeach}}
					</div>
				</div>
				{{endif}}

				<div class="gdsr-side-box">
					<h3 class="gdsr-fh">{lang="gdsearch_filters"}</h3>
					<label style="display:flex;align-items:center;gap:8px;margin-bottom:8px;cursor:pointer">
						<input type="checkbox" name="in_stock" value="1" {{if $filters['in_stock']}}checked{{endif}}>
						<span style="font-size:0.9em">{lang="gdsearch_filter_in_stock"}</span>
					</label>
					<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
						<input type="checkbox" name="requires_ffl" value="1" {{if $filters['requires_ffl']}}checked{{endif}}>
						<span style="font-size:0.9em">{lang="gdsearch_filter_requires_ffl"}</span>
					</label>
				</div>

				<button type="submit" class="ipsButton ipsButton--primary ipsButton--small" style="width:100%;margin-bottom:6px">{lang="gdsearch_filter_apply"}</button>
				<a href="{url="app=gdsearch&module=search&controller=results"}&q={$query}" class="ipsButton ipsButton--text ipsButton--small" style="width:100%;text-align:center">{lang="gdsearch_filter_clear"}</a>
			</form>
		</div>

		<div>
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
				<p style="margin:0;color:#64748b;font-size:0.9em">
					{{if $query}}{expression="number_format($total)"} {lang="gdsearch_results_for"} <strong>{$query}</strong>{{else}}{expression="number_format($total)"} {lang="gdsearch_results_total"}{{endif}}
				</p>
				<form method="get" action="{url="app=gdsearch&module=search&controller=results"}">
					<input type="hidden" name="app" value="gdsearch">
					<input type="hidden" name="module" value="search">
					<input type="hidden" name="controller" value="results">
					<input type="hidden" name="q" value="{$query}">
					<input type="hidden" name="category" value="{$filters['category_id']}">
					{{foreach $filters['brand'] as $v}}<input type="hidden" name="brand[]" value="{$v}">{{endforeach}}
					{{foreach $filters['caliber'] as $v}}<input type="hidden" name="caliber[]" value="{$v}">{{endforeach}}
					{{foreach $filters['action'] as $v}}<input type="hidden" name="action[]" value="{$v}">{{endforeach}}
					{{foreach $filters['casing'] as $v}}<input type="hidden" name="casing[]" value="{$v}">{{endforeach}}
					{{foreach $filters['bullet_type'] as $v}}<input type="hidden" name="bullet_type[]" value="{$v}">{{endforeach}}
					{{foreach $filters['capacity'] as $v}}<input type="hidden" name="capacity[]" value="{$v}">{{endforeach}}
					{{if !empty($filters['is_ammo'])}}<input type="hidden" name="is_ammo" value="1">{{endif}}
					{{foreach $filters['grain'] as $v}}<input type="hidden" name="grain[]" value="{$v}">{{endforeach}}
					{{foreach $filters['velocity'] as $v}}<input type="hidden" name="velocity[]" value="{$v}">{{endforeach}}
					{{if $filters['in_stock']}}<input type="hidden" name="in_stock" value="1">{{endif}}
					{{if $filters['requires_ffl']}}<input type="hidden" name="requires_ffl" value="1">{{endif}}
					<select name="sort" class="ipsInput ipsInput--select" onchange="this.form.submit()">
						<option value="relevance" {{if $sort === 'relevance'}}selected{{endif}}>{lang="gdsearch_sort_relevance"}</option>
						<option value="price_asc" {{if $sort === 'price_asc'}}selected{{endif}}>{lang="gdsearch_sort_price_asc"}</option>
						<option value="price_desc" {{if $sort === 'price_desc'}}selected{{endif}}>{lang="gdsearch_sort_price_desc"}</option>
						<option value="brand" {{if $sort === 'brand'}}selected{{endif}}>{lang="gdsearch_sort_brand"}</option>
					</select>
				</form>
			</div>

			{{if count($results) === 0 && !$error}}
			<div style="text-align:center;padding:48px 0;color:#94a3b8">
				<div style="font-size:2em;margin-bottom:12px">&#128269;</div>
				<p style="font-size:1.1em">{lang="gdsearch_no_results"}</p>
				{{if $query}}<p style="font-size:0.9em">Try different keywords or remove filters.</p>{{endif}}
			</div>
			{{else}}
			<div class="gdsr-grid">
				{{foreach $results as $product}}
				<a href="{url="app=gdsearch&module=search&controller=results&do=product&upc={$product['upc']}"}" class="gdsr-card">
					<span class="gd-compare-trigger gdsr-cmp" role="button"
						data-upc="{$product['upc']}"
						data-title="{$product['title']}"
						data-image="{$product['image_url']}"
						data-compare-url="{url="app=gdsearch&module=search&controller=results&do=compare"}">Compare</span>
					{{if $product['image_url']}}
					<div class="gdsr-thumb">
						<img src="{$product['image_url']}" alt="{$product['title']}">
					</div>
					{{else}}
					<div class="gdsr-noimg">&#128230;</div>
					{{endif}}
					<div style="padding:14px">
						<div style="font-size:0.78em;color:#94a3b8;margin-bottom:3px">{$product['brand']}</div>
						<div style="font-weight:600;font-size:0.92em;margin-bottom:10px;line-height:1.3;height:2.6em;overflow:hidden">{$product['title']}</div>
						{{if $product['caliber'] || $product['bullet_weight']}}<div style="font-size:0.76em;color:#475569;margin-bottom:10px">{{if $product['caliber']}}{$product['caliber']}{{endif}}{{if $product['caliber'] && $product['bullet_weight']}} &middot; {{endif}}{{if $product['bullet_weight']}}{$product['bullet_weight']}{{endif}}</div>{{endif}}
						<div style="display:flex;justify-content:space-between;align-items:flex-end">
							<div>
								{{if $product['best_price']}}
								<div style="color:#16a34a;font-weight:700;font-size:1.1em">${expression="number_format((float)$product['best_price'],2)"}</div>
								<div style="font-size:0.75em;color:#94a3b8">{$product['dealer_count']} {lang="gdsearch_dealers"}</div>
								{{else}}
								<div style="color:#94a3b8;font-size:0.85em">{lang="gdsearch_no_listings"}</div>
								{{endif}}
							</div>
							<div style="text-align:right">
								{{if $product['in_stock']}}<span class="ipsBadge ipsBadge--positive" style="font-size:0.7em">{lang="gdsearch_in_stock"}</span>{{else}}<span class="ipsBadge ipsBadge--neutral" style="font-size:0.7em">{lang="gdsearch_out_of_stock"}</span>{{endif}}
								{{if $product['requires_ffl']}}<div><span class="ipsBadge ipsBadge--warning" style="font-size:0.7em;margin-top:3px">{lang="gdsearch_requires_ffl"}</span></div>{{endif}}
							</div>
						</div>
					</div>
				</a>
				{{endforeach}}
			</div>
			{{if $pagination}}<div style="margin-top:24px">{$pagination|raw}</div>{{endif}}
			{{endif}}
		</div>
	</div>
</div>
