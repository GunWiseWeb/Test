								{{if $product['best_price']}}<div class="gdsr-deals">{$product['dealer_count']} {lang="gdsearch_dealers"}</div>{{endif}}
								{{if $product['in_stock']}}<span class="gdsr-stock">{lang="gdsearch_in_stock"}</span>{{else}}<span class="gdsr-stock out">{lang="gdsearch_out_of_stock"}</span>{{endif}}
								{{if $product['requires_ffl']}}<div><span class="ipsBadge ipsBadge--warning" style="font-size:0.66em;margin-top:4px">{lang="gdsearch_requires_ffl"}</span></div>{{endif}}
							</div>
						</div>
					</div>
				</a>
				{{endforeach}}
			</div>
			{{if $pagination}}<div style="margin-top:24px">{$pagination|raw}</div>{{endif}}
			{{endif}}
		</div>
	</div>
<script>
(function(){
var LIMIT = 8;
function initFacets(){
	var facets = document.querySelectorAll('.gdsr-facet');
	for(var i = 0; i < facets.length; i++){ initOne(facets[i]); }
}
function initOne(facet){
	var list = facet.querySelector('.gdsr-facet-list');
	if(!list) return;
	var opts = list.querySelectorAll('.gdsr-facet-opt');
	var search = facet.querySelector('.gdsr-facet-search');
	var sortBtn = facet.querySelector('.gdsr-facet-sort');
	var moreBtn = facet.querySelector('.gdsr-facet-more');
	var emptyEl = facet.querySelector('.gdsr-facet-empty');
	var expanded = false;
	function applyVis(){
		var visible = [];
		for(var j = 0; j < opts.length; j++){
			if(!opts[j].classList.contains('gdsr-search-hidden')){ visible.push(opts[j]); }
		}
		if(emptyEl){
			if(visible.length === 0){ emptyEl.classList.add('gdsr-show'); }
			else{ emptyEl.classList.remove('gdsr-show'); }
		}
		for(var k = 0; k < visible.length; k++){
			if(!expanded && k >= LIMIT){ visible[k].classList.add('gdsr-hidden'); }
			else{ visible[k].classList.remove('gdsr-hidden'); }
		}
		if(moreBtn){
			if(visible.length > LIMIT){
				moreBtn.style.display = 'block';
				moreBtn.textContent = expanded ? 'Show Less' : 'Show More';
			} else {
				moreBtn.style.display = 'none';
			}
		}
	}
	if(search){
		search.addEventListener('input', function(){
			var q = this.value.toLowerCase();
			for(var j = 0; j < opts.length; j++){
				var txt = opts[j].querySelector('span');
				if(!txt) continue;
				if(q === '' || txt.textContent.toLowerCase().indexOf(q) !== -1){
					opts[j].classList.remove('gdsr-search-hidden');
				} else {
					opts[j].classList.add('gdsr-search-hidden');
				}
			}
			applyVis();
		});
	}
	if(sortBtn){
		sortBtn.addEventListener('click', function(ev){
			ev.preventDefault();
			ev.stopPropagation();
			var mode = this.getAttribute('data-sort');
			var arr = Array.prototype.slice.call(opts);
			if(mode === 'count'){
				arr.sort(function(a, b){
					var ta = a.querySelector('span');
					var tb = b.querySelector('span');
					var na = ta ? ta.textContent.toLowerCase() : '';
					var nb = tb ? tb.textContent.toLowerCase() : '';
					return na < nb ? -1 : na > nb ? 1 : 0;
				});
				this.setAttribute('data-sort', 'name');
			} else {
				arr.sort(function(a, b){
					var ea = a.querySelector('em');
					var eb = b.querySelector('em');
					var ca = ea ? parseInt(ea.textContent, 10) : 0;
					var cb = eb ? parseInt(eb.textContent, 10) : 0;
					return cb - ca;
				});
				this.setAttribute('data-sort', 'count');
			}
			for(var j = 0; j < arr.length; j++){ list.appendChild(arr[j]); }
			applyVis();
		});
	}
	if(moreBtn){
		moreBtn.addEventListener('click', function(){
			expanded = !expanded;
			applyVis();
		});
	}
	applyVis();
}
if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', initFacets); }
else{ initFacets(); }
})();
</script>
</div>
