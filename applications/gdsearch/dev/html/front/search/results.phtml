<ips:template parameters="$query, $results, $total, $pagination, $filters, $sort, $aggs, $categories, $error" />
<div style="max-width:1200px;margin:0 auto;padding:16px">

	{{/* Search bar */}}
	<form method="get" action="{url="app=gdsearch&module=search&controller=results"}" style="margin-bottom:24px">
		<div style="display:flex;gap:8px">
			<input type="text" name="q" class="ipsInput ipsInput--text" style="flex:1;font-size:1.1em;padding:10px 14px" value="{$query}" placeholder="{lang="gdsearch_search_placeholder"}" autofocus>
			<button type="submit" class="ipsButton ipsButton--primary" style="padding:10px 24px">{lang="gdsearch_search_submit"}</button>
		</div>
	</form>

	{{if $error}}
	<div style="background:#fef2f2;border:1px solid #dc2626;border-radius:6px;padding:12px;margin-bottom:16px;color:#dc2626">
		Search unavailable: {$error}
	</div>
	{{endif}}

	<div style="display:grid;grid-template-columns:220px 1fr;gap:24px">

		{{/* Filters sidebar */}}
		<div>
			<form method="get" action="{url="app=gdsearch&module=search&controller=results"}">
				<input type="hidden" name="q" value="{$query}">
				<input type="hidden" name="sort" value="{$sort}">

				<div style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;padding:16px;margin-bottom:12px">
					<h3 style="margin:0 0 12px;font-size:0.9em;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#666">{lang="gdsearch_filter_category"}</h3>
					<select name="category" class="ipsInput ipsInput--select" style="width:100%" onchange="this.form.submit()">
						<option value="">All Categories</option>
						{{foreach $categories as $cat}}
						<option value="{$cat['name']}" {{if $filters['category'] === $cat['name']}}selected{{endif}}>{$cat['name']}</option>
						{{endforeach}}
					</select>
				</div>

				<div style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;padding:16px;margin-bottom:12px">
					<h3 style="margin:0 0 12px;font-size:0.9em;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#666">{lang="gdsearch_filter_price"}</h3>
					<div style="display:flex;gap:6px;align-items:center">
						<input type="number" name="min_price" placeholder="Min" class="ipsInput ipsInput--text" style="width:80px" value="{{if $filters['min_price'] > 0}}{$filters['min_price']}{{endif}}">
						<span style="color:#999">–</span>
						<input type="number" name="max_price" placeholder="Max" class="ipsInput ipsInput--text" style="width:80px" value="{{if $filters['max_price'] > 0}}{$filters['max_price']}{{endif}}">
					</div>
				</div>

				<div style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;padding:16px;margin-bottom:12px">
					<h3 style="margin:0 0 12px;font-size:0.9em;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#666">{lang="gdsearch_filters"}</h3>
					<label style="display:flex;align-items:center;gap:8px;margin-bottom:8px;cursor:pointer">
						<input type="checkbox" name="in_stock" value="1" {{if $filters['in_stock']}}checked{{endif}} onchange="this.form.submit()">
						<span style="font-size:0.9em">{lang="gdsearch_filter_in_stock"}</span>
					</label>
					<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
						<input type="checkbox" name="requires_ffl" value="1" {{if $filters['requires_ffl']}}checked{{endif}} onchange="this.form.submit()">
						<span style="font-size:0.9em">{lang="gdsearch_filter_requires_ffl"}</span>
					</label>
				</div>

				<button type="submit" class="ipsButton ipsButton--secondary ipsButton--small" style="width:100%;margin-bottom:6px">{lang="gdsearch_filter_apply"}</button>
				<a href="{url="app=gdsearch&module=search&controller=results"}&q={$query}" class="ipsButton ipsButton--text ipsButton--small" style="width:100%;text-align:center">{lang="gdsearch_filter_clear"}</a>
			</form>
		</div>

		{{/* Results area */}}
		<div>
			{{/* Sort + count bar */}}
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
				<p style="margin:0;color:#666;font-size:0.9em">
					{{if $query}}{expression="number_format($total)"} {lang="gdsearch_results_for"} <strong>{$query}</strong>{{else}}{expression="number_format($total)"} {lang="gdsearch_results_total"}{{endif}}
				</p>
				<form method="get" action="{url="app=gdsearch&module=search&controller=results"}">
					<input type="hidden" name="q" value="{$query}">
					<input type="hidden" name="category" value="{$filters['category']}">
					<input type="hidden" name="brand" value="{$filters['brand']}">
					<input type="hidden" name="caliber" value="{$filters['caliber']}">
					{{if $filters['in_stock']}}<input type="hidden" name="in_stock" value="1">{{endif}}
					{{if $filters['requires_ffl']}}<input type="hidden" name="requires_ffl" value="1">{{endif}}
					<select name="sort" class="ipsInput ipsInput--select" onchange="this.form.submit()">
						<option value="relevance" {{if $sort === 'relevance'}}selected{{endif}}>{lang="gdsearch_sort_relevance"}</option>
						<option value="price_asc" {{if $sort === 'price_asc'}}selected{{endif}}>{lang="gdsearch_sort_price_asc"}</option>
						<option value="price_desc" {{if $sort === 'price_desc'}}selected{{endif}}>{lang="gdsearch_sort_price_desc"}</option>
						<option value="brand" {{if $sort === 'brand'}}selected{{endif}}>{lang="gdsearch_sort_brand"}</option>
					</select>
				</form>
			</div>

			{{if count($results) === 0 && !$error}}
			<div style="text-align:center;padding:48px 0;color:#999">
				<div style="font-size:2em;margin-bottom:12px">🔍</div>
				<p style="font-size:1.1em">{lang="gdsearch_no_results"}</p>
				{{if $query}}<p style="font-size:0.9em">Try different keywords or remove filters.</p>{{endif}}
			</div>
			{{else}}
			<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
				{{foreach $results as $product}}
				<a href="{url="app=gdsearch&module=search&controller=results&do=product&upc={$product['upc']}"}" style="text-decoration:none;color:inherit;display:block;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;background:#fff;transition:box-shadow 0.15s" class="ipsLinkPanel">
					{{if $product['image_url']}}
					<div style="height:160px;background:#f8f9fa;display:flex;align-items:center;justify-content:center;padding:8px">
						<img src="{$product['image_url']}" style="max-height:144px;max-width:100%;object-fit:contain" alt="{$product['title']}">
					</div>
					{{else}}
					<div style="height:80px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;color:#ccc;font-size:2em">📦</div>
					{{endif}}
					<div style="padding:12px">
						<div style="font-size:0.78em;color:#888;margin-bottom:3px">{$product['brand']}</div>
						<div style="font-weight:600;font-size:0.88em;margin-bottom:8px;line-height:1.3;height:2.6em;overflow:hidden">{$product['title']}</div>
						<div style="display:flex;justify-content:space-between;align-items:flex-end">
							<div>
								{{if $product['best_price']}}
								<div style="color:#16a34a;font-weight:700;font-size:1.05em">${expression="number_format((float)$product['best_price'],2)"}</div>
								<div style="font-size:0.75em;color:#888">{$product['dealer_count']} {lang="gdsearch_dealers"}</div>
								{{else}}
								<div style="color:#999;font-size:0.85em">{lang="gdsearch_no_listings"}</div>
								{{endif}}
							</div>
							<div style="text-align:right">
								{{if $product['in_stock']}}<span class="ipsBadge ipsBadge--positive" style="font-size:0.7em">{lang="gdsearch_in_stock"}</span>{{else}}<span class="ipsBadge ipsBadge--neutral" style="font-size:0.7em">{lang="gdsearch_out_of_stock"}</span>{{endif}}
								{{if $product['requires_ffl']}}<div><span class="ipsBadge ipsBadge--warning" style="font-size:0.7em;margin-top:3px">{lang="gdsearch_requires_ffl"}</span></div>{{endif}}
							</div>
						</div>
					</div>
				</a>
				{{endforeach}}
			</div>
			{{if $pagination}}<div style="margin-top:24px">{$pagination|raw}</div>{{endif}}
			{{endif}}
		</div>
	</div>
</div>
