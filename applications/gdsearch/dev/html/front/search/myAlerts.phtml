<ips:template parameters="$alerts, $csrfKey" />
<style>
.gracct { max-width:980px; margin:0 auto; padding:28px 20px 56px; font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif }
.gracct-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; padding-bottom:18px; margin-bottom:24px; border-bottom:2px solid #e2e8f0 }
.gracct-head h1 { font-size:1.9em; font-weight:800; letter-spacing:-.02em; color:#0f172a; margin:0; line-height:1.1 }
.gracct-head p { margin:6px 0 0; color:#64748b; font-size:.95em }
.gracct-count { flex:none; background:#1E3A8A; color:#fff; font-weight:700; font-size:.8em; padding:6px 14px; border-radius:999px; letter-spacing:.02em }
.gracct-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(440px,1fr)); gap:16px }
.gracct-card { display:flex; align-items:center; gap:18px; background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:18px; transition:box-shadow .15s ease, border-color .15s ease, transform .15s ease }
.gracct-card:hover { border-color:#1E40AF; box-shadow:0 8px 24px -10px rgba(30,58,138,.35); transform:translateY(-1px) }
.gracct-thumb { width:84px; height:84px; flex:none; border-radius:10px; object-fit:contain; background:#f8fafc; border:1px solid #eef2f7 }
.gracct-thumb-ph { width:84px; height:84px; flex:none; border-radius:10px; background:#f1f5f9; border:1px solid #eef2f7; display:flex; align-items:center; justify-content:center; color:#cbd5e1; font-size:1.8em }
.gracct-info { flex:1; min-width:0 }
.gracct-title { font-weight:700; color:#0f172a; font-size:1.02em; margin:0 0 8px; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden }
.gracct-title a { color:inherit; text-decoration:none }
.gracct-title a:hover { color:#1E40AF }
.gracct-tags { display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:.85em }
.gracct-tag { background:#f1f5f9; color:#475569; border-radius:7px; padding:4px 10px; font-weight:600 }
.gracct-tag strong { color:#1E3A8A }
.gracct-tag--hit { background:#dcfce7; color:#15803d }
.gracct-tag--hit strong { color:#15803d }
.gracct-actions { flex:none; display:flex; flex-direction:column; gap:8px; align-items:stretch }
.gracct-view { text-align:center; font-size:.82em; font-weight:600; color:#1E40AF; text-decoration:none; border:1px solid #c7d2fe; background:#eef2ff; border-radius:8px; padding:7px 16px; transition:background .15s }
.gracct-view:hover { background:#e0e7ff }
.gracct-remove { font-size:.82em; font-weight:600; color:#64748b; background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:7px 16px; cursor:pointer; transition:border-color .15s, color .15s }
.gracct-remove:hover { border-color:#ef4444; color:#ef4444 }
.gracct-empty { text-align:center; padding:72px 24px; background:#fff; border:1px dashed #cbd5e1; border-radius:16px }
.gracct-empty-icon { font-size:2.6em; color:#cbd5e1; margin-bottom:10px }
.gracct-empty h2 { font-size:1.2em; color:#334155; margin:0 0 6px; font-weight:700 }
.gracct-empty p { color:#94a3b8; margin:0 0 18px }
.gracct-cta { display:inline-block; background:#1E3A8A; color:#fff; font-weight:700; text-decoration:none; padding:11px 26px; border-radius:10px; font-size:.95em; transition:background .15s }
.gracct-cta:hover { background:#1E40AF }
@media (max-width:560px){ .gracct-grid{ grid-template-columns:1fr } .gracct-card{ flex-wrap:wrap } .gracct-actions{ flex-direction:row; width:100% } .gracct-view,.gracct-remove{ flex:1 } }
</style>
<div class="gracct">
	<div class="gracct-head">
		<div>
			<h1>My Price Alerts</h1>
			<p>We'll notify you the moment a dealer drops to your target price.</p>
		</div>
		{{if count($alerts)}}<span class="gracct-count">{expression="count($alerts)"} active</span>{{endif}}
	</div>

	{{if count($alerts) === 0}}
	<div class="gracct-empty">
		<div class="gracct-empty-icon">&#128276;</div>
		<h2>No price alerts yet</h2>
		<p>Open any product and set an alert to get notified when the price drops.</p>
		<a class="gracct-cta" href="{expression="(string) \IPS\Http\Url::internal( 'app=gdsearch&module=search&controller=results', 'front' )"}">Browse Catalog</a>
	</div>
	{{else}}
	<div class="gracct-grid">
		{{foreach $alerts as $alert}}
		<div class="gracct-card" data-alert-id="{$alert['id']}" data-upc="{$alert['upc']}">
			{{if $alert['imageUrl']}}
			<img src="{$alert['imageUrl']}" alt="" class="gracct-thumb">
			{{else}}
			<div class="gracct-thumb-ph">&#128230;</div>
			{{endif}}
			<div class="gracct-info">
				<div class="gracct-title"><a href="{$alert['productUrl']}">{$alert['title']}</a></div>
				<div class="gracct-tags">
					<span class="gracct-tag">Target <strong>${expression="number_format((float)$alert['threshold'],2)"}</strong></span>
					{{if $alert['currentPrice'] !== null}}
						{{if $alert['currentPrice'] <= $alert['threshold']}}
						<span class="gracct-tag gracct-tag--hit">Now <strong>${expression="number_format((float)$alert['currentPrice'],2)"}</strong> &#10003;</span>
						{{else}}
						<span class="gracct-tag">Now <strong>${expression="number_format((float)$alert['currentPrice'],2)"}</strong></span>
						{{endif}}
					{{endif}}
				</div>
			</div>
			<div class="gracct-actions">
				<a class="gracct-view" href="{$alert['productUrl']}">View</a>
				<button type="button" class="gda-remove gracct-remove" data-cancel-url="{$alert['cancelUrl']}" data-csrf="{$csrfKey}" data-upc="{$alert['upc']}">Remove</button>
			</div>
		</div>
		{{endforeach}}
	</div>
	{{endif}}
</div>
