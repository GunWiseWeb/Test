<ips:template parameters="$feeds, $feedCounts, $addUrl, $reorderUrl, $csrfKey, $reExtractUrl" />
<div class="ipsBox ipsPull">
	<div style="display:flex;gap:8px;padding:10px 16px;border-bottom:1px solid var(--i-border-color, #e0e0e0)">
		<a href="{$addUrl}" class="ipsButton ipsButton--primary ipsButton--small">+ Add Source</a>
		{{if $reExtractUrl}}<a href="{$reExtractUrl}" class="ipsButton ipsButton--normal ipsButton--small" onclick="return confirm('Re-extract attributes from stored raw data for all products?');">Re-extract Attributes</a>{{endif}}
	</div>
	<div class="ipsBox_body ipsPad">

		<div style="display:flex;gap:16px;margin-bottom:24px">
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$feedCounts['total']}</div>
				<div>Configured Sources</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$feedCounts['active']}</div>
				<div>Active Sources</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$feedCounts['urls']}</div>
				<div>URLs Configured</div>
			</div>
		</div>

		<p class="ipsType_light" style="margin-bottom:16px">{lang="gdcatalog_feeds_help"}</p>

		{{if count($feeds) === 0}}
			<div class="ipsEmptyMessage"><p>{lang="gdcatalog_feeds_empty"}</p></div>
		{{else}}
		<table class="ipsTable ipsTable_zebra ipsTable_reorder" style="width:100%" data-reorder-url="{$reorderUrl}" data-csrf-key="{$csrfKey}" data-controller="core.admin.core.table">
			<thead>
				<tr>
					<th style="width:30px"></th>
					<th style="width:5%">#</th>
					<th>Source</th>
					<th>Type</th>
					<th>Schedule</th>
					<th>State</th>
					<th>Last Run</th>
					<th>Records</th>
					<th>Result</th>
					<th style="width:280px">Primary</th>
					<th style="width:260px">Advanced</th>
				</tr>
			</thead>
			<tbody class="gdcatalog-sortable">
				{{foreach $feeds as $feed}}
				<tr data-feed-id="{$feed['id']}">
					<td class="gdcatalog-drag-handle" style="cursor:grab;width:30px;text-align:center"><i class="fa-solid fa-bars"></i></td>
					<td>{$feed['priority']}</td>
					<td>
						<strong>{$feed['feed_name']}</strong><br>
						<span style="font-size:0.85em;color:var(--i-color-soft)">{$feed['distributor_label']}</span>
					</td>
					<td>
						{$feed['type_label']}
						{{if $feed['is_locked']}}
						<br><span class="ipsBadge ipsBadge--warning" style="margin-top:4px">Locked</span>
						{{endif}}
					</td>
					<td>{$feed['import_schedule']}</td>
					<td>
						{{if $feed['active']}}
							<span class="ipsBadge ipsBadge--positive">Active</span>
						{{else}}
							<span class="ipsBadge ipsBadge--neutral">Inactive</span>
						{{endif}}
					</td>
					<td>
						{{if $feed['last_run']}}
							{$feed['last_run']}
						{{else}}
							&mdash;
						{{endif}}
					</td>
					<td>{expression="number_format( $feed['last_record_count'] )"}</td>
					<td>
						{{if $feed['last_run_status'] === 'completed'}}
							<span class="ipsBadge ipsBadge--positive">OK</span>
						{{elseif $feed['last_run_status'] === 'failed'}}
							<span class="ipsBadge ipsBadge--negative">Failed</span>
						{{elseif $feed['last_run_status'] === 'running'}}
							<span class="ipsBadge ipsBadge--warning">Running</span>
						{{else}}
							&mdash;
						{{endif}}
					</td>
					<td>
						{{if $feed['is_manual_upload']}}
							<a href="{$feed['upload_url']}" class="ipsButton ipsButton--secondary ipsButton--small">Upload File</a>
							{{if $feed['has_upload']}}
							<a href="{$feed['run_manual_url']}" class="ipsButton ipsButton--positive ipsButton--small" data-confirm data-confirmMessage="Run import using {$feed['upload_filename']}?">Run Import</a>
							<span style="font-size:0.85em;display:block;margin-top:2px;color:var(--i-color-soft)">{$feed['upload_filename']}</span>
							{{else}}
							<span style="font-size:0.85em;display:block;margin-top:2px;color:var(--i-color-soft)">No file uploaded</span>
							{{endif}}
						{{elseif $feed['is_sportssouth']}}
							<a href="{$feed['edit_url']}" class="ipsButton ipsButton--primary ipsButton--small">Edit</a>
							{{if $feed['test_url']}}
							<a href="{$feed['test_url']}" class="ipsButton ipsButton--secondary ipsButton--small">Test Connection</a>
							{{endif}}
							<span style="font-size:0.85em;display:block;margin-top:4px;color:var(--i-color-soft)">Runs via queued task &mdash; not launched from this list.</span>
						{{else}}
							<a href="{$feed['edit_url']}" class="ipsButton ipsButton--primary ipsButton--small">Edit</a>
							{{if $feed['can_test_source']}}
							<a href="{$feed['test_source_url']}" class="ipsButton ipsButton--secondary ipsButton--small">Test Source</a>
							{{endif}}
							{{if $feed['can_run']}}
							<a href="{$feed['run_url']}" class="ipsButton ipsButton--positive ipsButton--small" data-confirm data-confirmMessage="Run import now for this source?">Run Import</a>
							{{endif}}
						{{endif}}
					</td>
					<td>
						{{if !$feed['is_manual_upload']}}
						<a href="{$feed['edit_url']}" class="ipsButton ipsButton--normal ipsButton--small">Edit</a>
						{{endif}}
						{{if $feed['can_refresh_lookups']}}
						<a href="{$feed['refresh_lookups_url']}" class="ipsButton ipsButton--soft ipsButton--small">Refresh Lookups</a>
						{{endif}}
						{{if $feed['is_locked']}}
						<a href="{$feed['unlock_catalog_url']}" class="ipsButton ipsButton--positive ipsButton--small" data-confirm>Unlock</a>
						{{else}}
						<a href="{$feed['lock_catalog_url']}" class="ipsButton ipsButton--soft ipsButton--small" data-confirm>Lock</a>
						{{endif}}
						{{if $feed['reset_url']}}
						<a href="{$feed['reset_url']}" class="ipsButton ipsButton--negative ipsButton--small" data-confirm data-confirmMessage="Reset this source's running status? Only do this if the import is stuck.">Reset Status</a>
						{{endif}}
						<a href="{$feed['delete_url']}" class="ipsButton ipsButton--negative ipsButton--small" data-confirm data-confirmMessage="Delete this source and all associated data?">Delete</a>
					</td>
				</tr>
				{{if $feed['last_import_log']}}
				<tr>
					<td colspan="11" style="padding:4px 16px 8px 60px;background:#f9fafb;font-size:0.85em;color:#555">
						<strong>Last Import:</strong>
						{$feed['last_import_log']['run_start']}
						&mdash; Processed: {expression="number_format( (int) $feed['last_import_log']['records_total'] )"}
						| Created: {expression="number_format( (int) $feed['last_import_log']['records_created'] )"}
						| Updated: {expression="number_format( (int) $feed['last_import_log']['records_updated'] )"}
						| Skipped: {expression="number_format( (int) $feed['last_import_log']['records_skipped'] )"}
						| Errors: {expression="number_format( (int) $feed['last_import_log']['records_errored'] )"}
						{{if $feed['last_import_log']['upc_invalid_count']}}
						| UPC Invalid: {expression="number_format( (int) $feed['last_import_log']['upc_invalid_count'] )"}
						{{endif}}
						{{if $feed['last_import_log']['upc_flagged_count']}}
						| UPC Flagged: {expression="number_format( (int) $feed['last_import_log']['upc_flagged_count'] )"}
						{{endif}}
					</td>
				</tr>
				{{endif}}
				{{endforeach}}
			</tbody>
		</table>
		{{endif}}

	</div>
</div>
