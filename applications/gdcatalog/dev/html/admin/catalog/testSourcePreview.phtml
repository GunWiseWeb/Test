<ips:template parameters="$sourceName, $authType, $formatUpper, $recordCount, $rows, $backUrl" />
<div style="padding:16px 20px;max-width:1200px;margin:0 auto">
	<h2 style="margin:0 0 4px">Test Source: {$sourceName}</h2>
	<div style="color:var(--i-color-soft);margin-bottom:16px">
		auth_type={$authType} &middot; format={$formatUpper} &middot; sample size {$recordCount}
	</div>

	<div class="ipsMessage ipsMessage--info" style="margin-bottom:16px">
		<p><strong>Read-only preview.</strong> No products were created or updated, no conflicts were logged, no OpenSearch queue was written to, and no discontinuation processing ran. Only the source's own endpoint was contacted.</p>
	</div>

	{{if $recordCount === 0}}
		<div class="ipsEmptyMessage"><p>The source returned no records for this test. Check the endpoint URL, credentials, or feed content.</p></div>
	{{else}}
		{{foreach $rows as $row}}
		<div class="ipsBox" style="margin-bottom:16px">
			<div class="ipsBox_header" style="padding:8px 16px;border-bottom:1px solid var(--i-border-color,#e0e0e0);background:#f9fafb">
				<strong>Record #{$row['idx']}</strong>
				{{if $row['error']}}
				<span class="ipsBadge ipsBadge--negative" style="margin-left:8px">Adapter error</span>
				{{endif}}
			</div>
			<div class="ipsBox_body" style="display:grid;grid-template-columns:1fr 1fr;gap:0">
				<div style="padding:12px 16px;border-right:1px solid var(--i-border-color,#e0e0e0)">
					<div style="font-weight:600;margin-bottom:8px">Raw Source Record</div>
					<table style="width:100%;font-size:0.85em;border-collapse:collapse">
						{{foreach $row['raw'] as $k => $v}}
						<tr>
							<th style="text-align:left;padding:3px 6px 3px 0;vertical-align:top;color:var(--i-color-soft);width:35%;font-weight:500;word-break:break-all">{$k}</th>
							<td style="padding:3px 0;vertical-align:top;word-break:break-word">{expression="htmlspecialchars( is_scalar( $v ) ? (string) $v : json_encode( $v ), ENT_QUOTES, 'UTF-8' )"}</td>
						</tr>
						{{endforeach}}
					</table>
				</div>
				<div style="padding:12px 16px">
					<div style="font-weight:600;margin-bottom:8px">Normalized Canonical</div>
					{{if $row['error']}}
					<div class="ipsMessage ipsMessage--error">{$row['error']}</div>
					{{else}}
					<table style="width:100%;font-size:0.85em;border-collapse:collapse">
						{{if count($row['canonical']) === 0}}
						<tr><td colspan="2" style="padding:8px 0;color:var(--i-color-soft)">
							(empty canonical &mdash; check the field_mapping JSON on this source's Edit page. StructuredFeedAdapter only picks keys named in the mapping.)
						</td></tr>
						{{else}}
						{{foreach $row['canonical'] as $k => $v}}
						<tr>
							<th style="text-align:left;padding:3px 6px 3px 0;vertical-align:top;color:var(--i-color-soft);width:35%;font-weight:500;word-break:break-all">{$k}</th>
							<td style="padding:3px 0;vertical-align:top;word-break:break-word">{expression="htmlspecialchars( is_scalar( $v ) ? (string) $v : json_encode( $v ), ENT_QUOTES, 'UTF-8' )"}</td>
						</tr>
						{{endforeach}}
						{{endif}}
					</table>
					{{endif}}
				</div>
			</div>
		</div>
		{{endforeach}}
	{{endif}}

	<div style="margin-top:16px">
		<a href="{$backUrl}" class="ipsButton ipsButton_normal">Back to sources</a>
	</div>
</div>
