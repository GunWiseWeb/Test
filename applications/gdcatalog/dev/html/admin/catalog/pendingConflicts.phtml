<ips:template parameters="$rows, $logUrl, $keepUrl, $customUrl, $csrfKey" />
<div class="ipsBox ipsPull">
	<div style="display:flex;gap:8px;padding:10px 16px;border-bottom:1px solid var(--i-border-color, #e0e0e0);align-items:center">
		<a href="{$logUrl}" class="ipsButton ipsButton--soft ipsButton--small">&larr; Back to Conflict Log</a>
		<span style="margin-left:auto;font-size:.9em;color:#6B7280">{expression="count($rows)"} pending conflict(s)</span>
	</div>
	<div class="ipsBox_body ipsPad">
		{{if count($rows) === 0}}
		<div class="ipsEmptyMessage"><p>No pending conflicts awaiting resolution.</p></div>
		{{else}}
		<table class="ipsTable ipsTable_zebra" style="width:100%">
			<thead>
				<tr>
					<th>UPC</th>
					<th>Field</th>
					<th>Current Value</th>
					<th>Incoming Value</th>
					<th>Distributor</th>
					<th>Detected</th>
					<th style="min-width:280px">Actions</th>
				</tr>
			</thead>
			<tbody>
				{{foreach $rows as $row}}
				<tr>
					<td><code>{$row['upc']}</code></td>
					<td>{$row['field_name']}</td>
					<td style="max-width:180px;word-break:break-word">{$row['current_value']}</td>
					<td style="max-width:180px;word-break:break-word">{$row['incoming_value']}</td>
					<td>{$row['distributor']}</td>
					<td style="white-space:nowrap">{$row['detected_at']}</td>
					<td>
						<div style="display:flex;flex-direction:column;gap:6px">
							<a href="{$row['accept_url']}" class="ipsButton ipsButton--positive ipsButton--small">Accept Incoming</a>
							<form method="post" action="{$keepUrl}" style="display:flex;gap:4px;align-items:center">
								<input type="hidden" name="csrfKey" value="{$csrfKey}">
								<input type="hidden" name="id" value="{$row['id']}">
								<input type="text" name="reason" placeholder="Reason (optional)" class="ipsInput ipsInput--text" style="flex:1;min-width:100px;font-size:.85em">
								<button type="submit" class="ipsButton ipsButton--secondary ipsButton--small" style="white-space:nowrap">Keep Current</button>
							</form>
							<form method="post" action="{$customUrl}" style="display:flex;gap:4px;align-items:center">
								<input type="hidden" name="csrfKey" value="{$csrfKey}">
								<input type="hidden" name="id" value="{$row['id']}">
								<input type="text" name="custom_value" placeholder="Custom value" class="ipsInput ipsInput--text" style="flex:1;min-width:80px;font-size:.85em" required>
								<input type="text" name="reason" placeholder="Reason" class="ipsInput ipsInput--text" style="flex:1;min-width:80px;font-size:.85em">
								<button type="submit" class="ipsButton ipsButton--warning ipsButton--small" style="white-space:nowrap">Set Custom</button>
							</form>
						</div>
					</td>
				</tr>
				{{endforeach}}
			</tbody>
		</table>
		{{endif}}
	</div>
</div>
