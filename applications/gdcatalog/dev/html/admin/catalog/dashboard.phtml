<ips:template parameters="$totalProducts, $activeProducts, $reviewProducts, $pendingConflicts, $distributorStats, $taskUrls, $osExists, $osStats, $reindexQueue, $lockedFields, $runQueueUrl, $queueCount, $syncBrandsUrl, $monitorUrl" />
<div class="ipsBox ipsPull">
	<div class="ipsBox_body ipsPad">
		<div id="gdcatalog-monitor" class="ipsBox" style="margin-bottom:16px;padding:16px" data-monitor-url="{$monitorUrl}">
			<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
				<h3 style="margin:0;font-size:1em;font-weight:600">Live Catalog Status</h3>
				<span style="font-size:0.8em;color:var(--i-color-soft)">Updated: <span id="gdc-updated">&mdash;</span></span>
			</div>
			<div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:12px">
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold" id="gdc-products">&mdash;</div>
					<div style="font-size:0.75em">Total Products</div>
				</div>
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold;color:var(--i-positive)" id="gdc-active">&mdash;</div>
					<div style="font-size:0.75em">Active</div>
				</div>
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold;color:var(--i-warning)" id="gdc-conflicts">&mdash;</div>
					<div style="font-size:0.75em">Pending Conflicts</div>
				</div>
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold;color:var(--i-negative)" id="gdc-broken">&mdash;</div>
					<div style="font-size:0.75em">Broken Images</div>
				</div>
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold" id="gdc-no-image">&mdash;</div>
					<div style="font-size:0.75em">No Image</div>
				</div>
				<div style="text-align:center;padding:8px;background:var(--i-background-2);border-radius:4px">
					<div style="font-size:1.4em;font-weight:bold;color:var(--i-primary)" id="gdc-queue">&mdash;</div>
					<div style="font-size:0.75em">Queue Jobs</div>
				</div>
			</div>
			<div style="margin-bottom:8px">
				<span style="font-size:0.8em;font-weight:600">Active Jobs:</span>
				<span id="gdc-jobs" style="margin-left:8px"></span>
			</div>
			<div>
				<span style="font-size:0.8em;font-weight:600">Last Import:</span>
				<span id="gdc-last-import" style="margin-left:8px;font-size:0.8em;color:var(--i-color-soft)">&mdash;</span>
			</div>
		</div>
		<div style="display:flex;gap:16px;margin-bottom:24px">
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{expression="number_format( (int) $totalProducts )"}</div>
				<div>Total Products</div>
				<div style="color:#666">Active: {expression="number_format( (int) $activeProducts )"} | Review: {expression="number_format( (int) $reviewProducts )"}</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$pendingConflicts}</div>
				<div>Pending Conflicts</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$lockedFields}</div>
				<div>Locked Fields</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{$reindexQueue}</div>
				<div>Reindex Queue</div>
			</div>
		</div>

		<h2 class="ipsType_sectionHead" style="margin:0 0 12px">Distributor Feeds</h2>

		{{if count($distributorStats) === 0}}
			<div class="ipsEmptyMessage"><p>{lang="gdcatalog_dash_feeds_empty"}</p></div>
		{{else}}
		<table class="ipsTable ipsTable_zebra" style="width:100%">
			<thead>
				<tr>
					<th>#</th>
					<th>Feed</th>
					<th>Products</th>
					<th>Status</th>
					<th>Last Run</th>
					<th>Last Status</th>
					<th style="width:300px">Actions</th>
				</tr>
			</thead>
			<tbody>
				{{foreach $distributorStats as $ds}}
				<tr>
					<td>{$ds['priority']}</td>
					<td><strong>{$ds['feed_name']}</strong></td>
					<td>{expression="number_format( (int) $ds['product_count'] )"}</td>
					<td>
						{{if $ds['active']}}
							<span class="ipsBadge ipsBadge--positive">Active</span>
						{{else}}
							<span class="ipsBadge ipsBadge--neutral">Inactive</span>
						{{endif}}
					</td>
					<td>
						{{if $ds['last_run_start']}}
							{$ds['last_run_start']}
						{{else}}
							&mdash;
						{{endif}}
					</td>
					<td>
						{{if $ds['is_running']}}
							<span class="ipsBadge ipsBadge--warning">Running</span>
						{{elseif $ds['is_failed']}}
							<span class="ipsBadge ipsBadge--negative">Failed</span>
						{{elseif $ds['last_status']}}
							{$ds['last_status']}
						{{else}}
							&mdash;
						{{endif}}
					</td>
					<td style="display:flex;gap:4px;flex-wrap:wrap">
						<a href="{$ds['run_import_url']}" class="ipsButton ipsButton--primary ipsButton--small">Run Import</a>
						{{if $ds['is_sportssouth']}}
							<a href="{$ds['queue_full_import_url']}" class="ipsButton ipsButton--secondary ipsButton--small">Queue Full Import</a>
						{{endif}}
						{{if $ds['is_locked']}}
							<a href="{$ds['unlock_catalog_url']}" class="ipsButton ipsButton--positive ipsButton--small">Unlock</a>
						{{else}}
							<a href="{$ds['lock_catalog_url']}" class="ipsButton ipsButton--soft ipsButton--small">Lock</a>
						{{endif}}
					</td>
				</tr>
				{{endforeach}}
			</tbody>
		</table>
		{{endif}}

		<h2 class="ipsType_sectionHead" style="margin:24px 0 8px;padding-top:24px;border-top:1px solid var(--i-border-color, #e0e0e0)">Tasks</h2>
		<div style="display:flex;gap:8px;flex-wrap:wrap">
			<a href="{$taskUrls['validate_images']}" class="ipsButton ipsButton--secondary ipsButton--small">Validate Images</a>
			<a href="{$taskUrls['resolve_conflicts']}" class="ipsButton ipsButton--secondary ipsButton--small">Resolve Conflicts</a>
			<a href="{$taskUrls['prune_log']}" class="ipsButton ipsButton--secondary ipsButton--small">Prune Log</a>
			<a href="{$syncBrandsUrl}" class="ipsButton ipsButton--secondary ipsButton--small" data-confirm data-confirmMessage="Sync brand names from Sports South API?">Sync SS Brands</a>
		</div>

		<h2 class="ipsType_sectionHead" style="margin:24px 0 8px;padding-top:24px;border-top:1px solid var(--i-border-color, #e0e0e0)">Queue</h2>
		<div style="display:flex;gap:8px;align-items:center">
			<a href="{$runQueueUrl}" class="ipsButton ipsButton--primary ipsButton--small" data-confirm data-confirmMessage="Process all pending import queue jobs now?">Run Queue Now</a>
			{{if $queueCount > 0}}
			<span class="ipsBadge ipsBadge--warning">{$queueCount} job(s) pending</span>
			{{else}}
			<span class="ipsBadge ipsBadge--positive">Queue empty</span>
			{{endif}}
		</div>

		<h2 class="ipsType_sectionHead" style="margin:24px 0 12px">{lang="gdcatalog_dash_opensearch_status"}</h2>
		{{if $osExists}}
		<div style="display:flex;gap:16px;margin-bottom:16px">
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{expression="isset($osStats['doc_count']) ? number_format($osStats['doc_count']) : '0'"}</div>
				<div>{lang="gdcatalog_dash_opensearch_count"}</div>
			</div>
			<div class="ipsBox" style="flex:1;padding:16px;text-align:center">
				<div style="font-size:2em;font-weight:bold">{expression="isset($osStats['size_bytes']) ? number_format($osStats['size_bytes']) : '0'"}</div>
				<div>Index Size (bytes)</div>
			</div>
		</div>
		<div style="display:flex;gap:8px">
			<a href="{$osStats['rebuild_url']}" class="ipsButton ipsButton--primary ipsButton--small">{lang="gdcatalog_dash_rebuild_index"}</a>
			<a href="{$osStats['process_queue_url']}" class="ipsButton ipsButton--secondary ipsButton--small">Process Queue</a>
		</div>
		{{else}}
		<div class="ipsMessage ipsMessage--info" style="margin-top:12px"><p>OpenSearch index not found. Build the index to enable fast product search and conflict resolution.</p></div>
		<a href="{$osStats['rebuild_url']}" class="ipsButton ipsButton--primary ipsButton--small">Build Index Now</a>
		{{endif}}

		{{if $reindexQueue}}
		<div style="background:#fef3c7;border:1px solid #f59e0b;padding:12px 16px;border-radius:8px;margin-top:16px">
			<strong>Reindex Queue:</strong> {$reindexQueue} products awaiting reindexing.
		</div>
		{{endif}}

	</div>
</div>
