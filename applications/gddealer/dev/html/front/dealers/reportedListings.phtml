<ips:template parameters="$data" />
<div class="gdPanel" style="background:#fff;border-radius:12px;padding:28px 32px;margin-bottom:24px">
	<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px">
		<h2 style="font-size:1.25em;font-weight:700;color:#0f172a;margin:0">Reported Listings</h2>
		<div style="display:flex;gap:6px;font-size:0.85em">
			<a href="?app=gddealer&module=dealers&controller=dashboard&do=reportedListings" class="gdBtn {{if $data['statusFilter'] === ''}}gdBtn--active{{endif}}" style="padding:4px 12px;border-radius:6px;text-decoration:none;border:1px solid #e2e8f0;color:#475569;{{if $data['statusFilter'] === ''}}background:#0f172a;color:#fff;border-color:#0f172a{{endif}}">All</a>
			<a href="?app=gddealer&module=dealers&controller=dashboard&do=reportedListings&report_status=new" class="gdBtn {{if $data['statusFilter'] === 'new'}}gdBtn--active{{endif}}" style="padding:4px 12px;border-radius:6px;text-decoration:none;border:1px solid #e2e8f0;color:#475569;{{if $data['statusFilter'] === 'new'}}background:#dc2626;color:#fff;border-color:#dc2626{{endif}}">New</a>
			<a href="?app=gddealer&module=dealers&controller=dashboard&do=reportedListings&report_status=reviewed" class="gdBtn {{if $data['statusFilter'] === 'reviewed'}}gdBtn--active{{endif}}" style="padding:4px 12px;border-radius:6px;text-decoration:none;border:1px solid #e2e8f0;color:#475569;{{if $data['statusFilter'] === 'reviewed'}}background:#f59e0b;color:#fff;border-color:#f59e0b{{endif}}">Reviewed</a>
			<a href="?app=gddealer&module=dealers&controller=dashboard&do=reportedListings&report_status=resolved" class="gdBtn {{if $data['statusFilter'] === 'resolved'}}gdBtn--active{{endif}}" style="padding:4px 12px;border-radius:6px;text-decoration:none;border:1px solid #e2e8f0;color:#475569;{{if $data['statusFilter'] === 'resolved'}}background:#16a34a;color:#fff;border-color:#16a34a{{endif}}">Resolved</a>
			<a href="?app=gddealer&module=dealers&controller=dashboard&do=reportedListings&report_status=dismissed" class="gdBtn {{if $data['statusFilter'] === 'dismissed'}}gdBtn--active{{endif}}" style="padding:4px 12px;border-radius:6px;text-decoration:none;border:1px solid #e2e8f0;color:#475569;{{if $data['statusFilter'] === 'dismissed'}}background:#64748b;color:#fff;border-color:#64748b{{endif}}">Dismissed</a>
		</div>
	</div>
	<p style="color:#64748b;font-size:0.9em;margin:0 0 16px">{expression="number_format($data['total'])"} total reports</p>
	{{if count($data['reports']) === 0}}
	<div style="text-align:center;padding:48px 0;color:#94a3b8">
		<div style="font-size:2em;margin-bottom:8px">&#x1f4cb;</div>
		<p style="margin:0">No reported listings.</p>
	</div>
	{{else}}
	<div style="display:flex;flex-direction:column;gap:12px">
		{{foreach $data['reports'] as $report}}
		<div style="border:1px solid #e2e8f0;border-radius:10px;padding:16px 20px;background:#fafbfc">
			<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap">
				<div style="flex:1;min-width:200px">
					<div style="font-weight:600;font-size:1em;color:#0f172a;margin-bottom:4px">
						{{if $report['product_title']}}
						{$report['product_title']}
						{{else}}
						UPC: {$report['upc']}
						{{endif}}
					</div>
					{{if $report['product_title']}}
					<div style="font-size:0.8em;color:#94a3b8;margin-bottom:6px">UPC: {$report['upc']}</div>
					{{endif}}
					<div style="margin-bottom:6px">
						<span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.8em;font-weight:600;background:#fef2f2;color:#dc2626;border:1px solid #fecaca">{$report['reason_label']}</span>
						{{if $report['status'] === 'new'}}
						<span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.8em;font-weight:600;background:#fef2f2;color:#dc2626">New</span>
						{{elseif $report['status'] === 'reviewed'}}
						<span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.8em;font-weight:600;background:#fffbeb;color:#d97706">Reviewed</span>
						{{elseif $report['status'] === 'resolved'}}
						<span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.8em;font-weight:600;background:#f0fdf4;color:#16a34a">Resolved</span>
						{{elseif $report['status'] === 'dismissed'}}
						<span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:0.8em;font-weight:600;background:#f1f5f9;color:#64748b">Dismissed</span>
						{{endif}}
					</div>
					{{if $report['note']}}
					<div style="font-size:0.9em;color:#475569;margin-bottom:4px;font-style:italic">&ldquo;{$report['note']}&rdquo;</div>
					{{endif}}
					<div style="font-size:0.8em;color:#94a3b8">Reported by {$report['reporter_name']} &middot; {$report['created_at']}</div>
				</div>
				<div style="display:flex;gap:6px;align-items:flex-start;flex-wrap:wrap">
					{{if $report['status'] === 'new'}}
					<a href="?app=gddealer&module=dealers&controller=dashboard&do=resolveReport&report_id={$report['id']}&new_status=reviewed&csrfKey={$data['csrfKey']}" class="gdBtn" style="padding:5px 14px;border-radius:6px;text-decoration:none;font-size:0.85em;border:1px solid #e2e8f0;color:#475569;background:#fff">Mark Reviewed</a>
					{{endif}}
					{{if $report['status'] === 'new' || $report['status'] === 'reviewed'}}
					<a href="?app=gddealer&module=dealers&controller=dashboard&do=resolveReport&report_id={$report['id']}&new_status=resolved&csrfKey={$data['csrfKey']}" class="gdBtn" style="padding:5px 14px;border-radius:6px;text-decoration:none;font-size:0.85em;border:1px solid #16a34a;color:#16a34a;background:#fff">Resolve</a>
					<a href="?app=gddealer&module=dealers&controller=dashboard&do=resolveReport&report_id={$report['id']}&new_status=dismissed&csrfKey={$data['csrfKey']}" class="gdBtn" style="padding:5px 14px;border-radius:6px;text-decoration:none;font-size:0.85em;border:1px solid #94a3b8;color:#64748b;background:#fff">Dismiss</a>
					{{endif}}
				</div>
			</div>
		</div>
		{{endforeach}}
	</div>
	{{if $data['pagination']}}
	<div style="margin-top:20px">{$data['pagination']|raw}</div>
	{{endif}}
	{{endif}}
</div>
