<ips:template parameters="$rebates, $manufacturers, $showExpired" />
<div class='gdrb-wrap'>
	<h1 class='gdrb-title'>{lang="gdrebates_page_title"}</h1>

	<div class='gdrb-filters'>
		<select id='gdrb-f-mfr' class='gdrb-sel'>
			<option value=''>{lang="gdrebates_f_all_mfr"}</option>
			{{foreach $manufacturers as $m}}<option value='{$m}'>{$m}</option>{{endforeach}}
		</select>
		<select id='gdrb-f-type' class='gdrb-sel'>
			<option value=''>{lang="gdrebates_f_all_type"}</option>
			<option value='cash'>{lang="gdrebates_type_cash"}</option>
			<option value='prepaid_card'>{lang="gdrebates_type_prepaid_card"}</option>
			<option value='store_credit'>{lang="gdrebates_type_store_credit"}</option>
			<option value='free_item'>{lang="gdrebates_type_free_item"}</option>
			<option value='free_shipping'>{lang="gdrebates_type_free_shipping"}</option>
			<option value='bundle'>{lang="gdrebates_type_bundle"}</option>
			<option value='other'>{lang="gdrebates_type_other"}</option>
		</select>
		<select id='gdrb-f-amt' class='gdrb-sel'>
			<option value=''>{lang="gdrebates_f_all_amt"}</option>
			<option value='1'>$1&ndash;49</option>
			<option value='2'>$50&ndash;99</option>
			<option value='3'>$100&ndash;199</option>
			<option value='4'>$200+</option>
			<option value='free'>{lang="gdrebates_type_free_item"}</option>
		</select>
		<select id='gdrb-f-sort' class='gdrb-sel'>
			<option value='ending'>{lang="gdrebates_sort_ending"}</option>
			<option value='amount'>{lang="gdrebates_sort_amount"}</option>
			<option value='newest'>{lang="gdrebates_sort_newest"}</option>
		</select>
		{{if $showExpired}}
		<label class='gdrb-hide-expired'>
			<input type='checkbox' id='gdrb-f-hide-expired'>
			<span>{lang="gdrebates_hide_expired"}</span>
		</label>
		{{endif}}
	</div>

	{{if count( $rebates )}}
	<div class='gdrb-grid' id='gdrb-grid'>
		{{foreach $rebates as $r}}
		<div class='gdrb-card{{if $r['_is_expired']}} gdrb-card--expired{{endif}}' data-mfr="{$r['manufacturer']}" data-type="{$r['rebate_type']}" data-amount="{$r['amount']}" data-end="{$r['end_date']}" data-created="{$r['created']}" data-expired="{{if $r['_is_expired']}}1{{else}}0{{endif}}">
			<div class='gdrb-card__head'>
				{{if $r['_logo']}}<img class='gdrb-card__logo' src='{$r['_logo']}' alt='{$r['manufacturer']}' loading='lazy'>{{else}}<span class='gdrb-card__mfr'>{$r['manufacturer']}</span>{{endif}}
				{{if $r['amount_text']}}<span class='gdrb-card__amt'>{$r['amount_text']}</span>{{endif}}
			</div>
			<div class='gdrb-card__title'>{$r['title']}</div>
			{{if count( $r['_models_list'] )}}
			<div class='gdrb-chips' data-model-count='{expression="count( $r['_models_list'] )"}'>
				{{foreach $r['_models_list'] as $mi => $mv}}<span class='gdrb-chip{{if $mi >= 5}} gdrb-chip--hidden{{endif}}'>{$mv}</span>{{endforeach}}
				{{if count( $r['_models_list'] ) > 5}}<button type='button' class='gdrb-chip gdrb-chip--more' data-hidden-count='{expression="count( $r['_models_list'] ) - 5"}' data-more-label='+{expression="count( $r['_models_list'] ) - 5"} {lang="gdrebates_chip_more"}' data-fewer-label='{lang="gdrebates_show_fewer"}'>+{expression="count( $r['_models_list'] ) - 5"} {lang="gdrebates_chip_more"}</button>{{endif}}
			</div>
			{{endif}}
			<div class='gdrb-card__meta'>
				<span class='gdrb-card__type gdrb-type--{$r['rebate_type']}'>{expression="\IPS\Member::loggedIn()->language()->addToStack( 'gdrebates_type_' . $r['rebate_type'] )"}</span>
				{{if $r['_is_expired']}}
					<span class='gdrb-card__expired-tag'>{lang="gdrebates_expired"}</span>
				{{elseif $r['_days_left'] !== null && $r['_days_left'] <= 1}}
					<span class='gdrb-countdown gdrb-countdown--urgent'>{lang="gdrebates_last_day"}</span>
				{{elseif $r['_days_left'] !== null && $r['_days_left'] <= 7}}
					<span class='gdrb-countdown gdrb-countdown--urgent'>{expression="\IPS\Member::loggedIn()->language()->addToStack( 'gdrebates_days_left', FALSE, [ 'sprintf' => [ $r['_days_left'] ] ] )"}</span>
				{{elseif $r['_days_left'] !== null && $r['_days_left'] <= 30}}
					<span class='gdrb-countdown gdrb-countdown--soon'>{expression="\IPS\Member::loggedIn()->language()->addToStack( 'gdrebates_days_left', FALSE, [ 'sprintf' => [ $r['_days_left'] ] ] )"}</span>
				{{elseif $r['end_date']}}
					<span class='gdrb-card__end'>{lang="gdrebates_ends"} {expression="\IPS\DateTime::ts( $r['end_date'] )->localeDate()"}</span>
				{{endif}}
			</div>
			<div class='gdrb-card__actions'>
				{{if $r['redemption_url']}}
					<a class='gdrb-btn gdrb-btn--primary' href='{$r['redemption_url']}' target='_blank' rel='noopener'>{lang="gdrebates_submit"}</a>
					{{if $r['source_url']}}<a class='gdrb-btn gdrb-btn--soft' href='{$r['source_url']}' target='_blank' rel='noopener'>{lang="gdrebates_details"}</a>{{endif}}
				{{elseif $r['source_url']}}
					<a class='gdrb-btn gdrb-btn--primary' href='{$r['source_url']}' target='_blank' rel='noopener'>{lang="gdrebates_view_offer"}</a>
				{{endif}}
			</div>
		</div>
		{{endforeach}}
	</div>
	<p class='gdrb-noresults' id='gdrb-noresults' style='display:none'>{lang="gdrebates_no_match"}</p>
	{{else}}
	<p class='gdrb-empty'>{lang="gdrebates_none"}</p>
	{{endif}}
</div>

<script>
(function(){
	var grid = document.getElementById('gdrb-grid');
	if(!grid){ return; }
	var cards = Array.prototype.slice.call(grid.querySelectorAll('.gdrb-card'));
	var fMfr = document.getElementById('gdrb-f-mfr');
	var fType = document.getElementById('gdrb-f-type');
	var fAmt = document.getElementById('gdrb-f-amt');
	var fSort = document.getElementById('gdrb-f-sort');
	/* v1.0.10 — Hide-expired checkbox (only present in DOM when the
	   ACP show-expired setting is ON; querySelector returns null
	   otherwise and the apply() gate below no-ops). */
	var fHideExpired = document.getElementById('gdrb-f-hide-expired');
	var noRes = document.getElementById('gdrb-noresults');

	/* v1.0.11 — chip "+N more" is now a proper bidirectional toggle.
	   Clicks flip a .gdrb-chips--expanded class on the container
	   (CSS reveals the .gdrb-chip--hidden items when the container
	   has that class) and swap the button label between the two
	   data-attribute strings the template emits — no lang lookup
	   in JS, no page reload, repeatable. */
	grid.addEventListener('click', function(ev){
		var btn = ev.target;
		if(!btn || !btn.classList || !btn.classList.contains('gdrb-chip--more')){ return; }
		ev.preventDefault();
		var container = btn.closest('.gdrb-chips');
		if(!container){ return; }
		var nowExpanded = container.classList.toggle('gdrb-chips--expanded');
		btn.textContent = nowExpanded
			? ( btn.getAttribute('data-fewer-label') || 'Show fewer' )
			: ( btn.getAttribute('data-more-label')  || '+more' );
	});

	function bucket(a){
		if(a===null || a===''){ return 'free'; }
		var n = parseFloat(a);
		if(isNaN(n)){ return 'free'; }
		if(n<50){ return '1'; }
		if(n<100){ return '2'; }
		if(n<200){ return '3'; }
		return '4';
	}
	function sortVisible(){
		var mode = fSort.value;
		var vis = cards.filter(function(c){ return c.style.display!=='none'; });
		vis.sort(function(a,b){
			/* v1.0.9 — expired ALWAYS goes to the bottom regardless
			   of sort mode. Active cards then use the picked sort. */
			var aExp = a.getAttribute('data-expired')==='1' ? 1 : 0;
			var bExp = b.getAttribute('data-expired')==='1' ? 1 : 0;
			if(aExp !== bExp){ return aExp - bExp; }

			if(mode==='amount'){ return (parseFloat(b.getAttribute('data-amount'))||0)-(parseFloat(a.getAttribute('data-amount'))||0); }
			if(mode==='newest'){ return (parseInt(b.getAttribute('data-created'))||0)-(parseInt(a.getAttribute('data-created'))||0); }
			var ea = parseInt(a.getAttribute('data-end'))||0;
			var eb = parseInt(b.getAttribute('data-end'))||0;
			if(ea===0 && eb===0){ return 0; }
			if(ea===0){ return 1; }
			if(eb===0){ return -1; }
			return ea-eb;
		});
		vis.forEach(function(c){ grid.appendChild(c); });
	}
	function apply(){
		var mfr=fMfr.value, type=fType.value, amt=fAmt.value, shown=0;
		/* v1.0.10 — hide-expired composes with the other filters:
		   a card must pass mfr/type/amt AND (if hide-expired is on)
		   the not-expired check. Missing checkbox (setting OFF) =>
		   hideExpired false, no effect. */
		var hideExpired = !!( fHideExpired && fHideExpired.checked );
		cards.forEach(function(c){
			var ok=true;
			if(mfr && c.getAttribute('data-mfr')!==mfr){ ok=false; }
			if(type && c.getAttribute('data-type')!==type){ ok=false; }
			if(amt && bucket(c.getAttribute('data-amount'))!==amt){ ok=false; }
			if(hideExpired && c.getAttribute('data-expired')==='1'){ ok=false; }
			c.style.display = ok ? '' : 'none';
			if(ok){ shown++; }
		});
		if(noRes){ noRes.style.display = shown ? 'none' : ''; }
		sortVisible();
	}
	[fMfr,fType,fAmt,fSort,fHideExpired].forEach(function(el){ if(el){ el.addEventListener('change', apply); } });
	sortVisible();
})();
</script>
