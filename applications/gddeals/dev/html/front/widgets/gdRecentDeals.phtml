<ips:template parameters="$items, $orientation='', $carousel=false" />
{expression="\IPS\gddeals\Application::colorCss()" raw="1"}
{{if !empty($items)}}
<header class='ipsWidget__header'>
	<h3>{lang="block_gdRecentDeals"}</h3>
</header>
<div class='ipsWidget__content'>
	<i-data>
		<ol class='ipsData ipsData--table ipsData--gd-deals'>
			{{foreach $items as $d}}
			<li class='ipsData__item'>
				<a href='{$d['url']}' class='ipsLinkPanel' tabindex="-1" aria-hidden="true"><span>{$d['title']}</span></a>
				<div class='ipsData__image' aria-hidden="true">
					{{if $d['image']}}<img src='{$d['image']}' alt='' loading='lazy'>{{else}}<span class='ipsThumb ipsThumb--tiny'></span>{{endif}}
				</div>
				<div class='ipsData__content'>
					<div class='ipsData__main'>
						<h4 class='ipsData__title'><a href='{$d['url']}'>{$d['title']}</a></h4>
						<p class='ipsData__meta'>{{if $d['dealer']}}<span class='gd-widget__badge'>Dealer</span> {{endif}}{$d['retailer']}</p>
					</div>
					<div class='ipsData__extra'>
						<span class='gd-widget__price'>{$d['price']}</span>{{if $d['discount']}} <span class='gd-widget__off'>{$d['discount']}</span>{{endif}}
					</div>
				</div>
			</li>
			{{endforeach}}
		</ol>
	</i-data>
</div>
{{endif}}
