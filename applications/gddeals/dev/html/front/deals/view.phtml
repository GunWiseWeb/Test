<ips:template parameters="$d" />
<div class="gd-deals-wrap gd-deal-view">
	{{if $d['is_pending']}}<div class="gd-pending-banner">{lang="gddeals_deal_pending"}</div>{{endif}}
	{{if $d['can_approve'] or $d['can_hide'] or $d['can_delete']}}
		<div class="gd-mod-bar">
			<span class="gd-mod-label">{lang="gddeals_mod_label"}</span>
			{{if $d['can_approve']}}<a class="gd-mod-btn gd-mod-approve" href="{$d['url_approve']}">{lang="gddeals_mod_approve"}</a>{{endif}}
			{{if $d['can_hide']}}<a class="gd-mod-btn" href="{$d['url_hide']}">{lang="gddeals_mod_hide"}</a>{{endif}}
			{{if $d['can_delete']}}<a class="gd-mod-btn gd-mod-delete" href="{$d['url_delete']}" onclick="return confirm('Delete this deal? This cannot be undone.')">{lang="gddeals_mod_delete"}</a>{{endif}}
		</div>
	{{endif}}
	<div class="gd-deal-layout">
		<div class="gd-deal-media">
			{{if $d['image']}}
				<img class="gd-deal-img" src="{$d['image']}" alt="{$d['title']}">
			{{else}}
				<div class="gd-deal-img gd-deal-img--empty">{$d['category_name']}</div>
			{{endif}}
		</div>
		<div class="gd-deal-info">
			<span class="gd-card-cat">{$d['category_name']}</span>
			<h1 class="gd-deal-h1">{$d['title']}</h1>
			<div class="gd-deal-retailer">{$d['retailer_name']}{{if $d['store_location']}} · {$d['store_location']}{{endif}}</div>
			<div class="gd-deal-pricerow">
				{{if $d['price']}}<span class="gd-price gd-price--lg">{$d['price']}</span>{{endif}}
				{{if $d['discount']}}<span class="gd-discount">{$d['discount']}% {lang="gddeals_off"}</span>{{endif}}
				{{if $d['original']}}<span class="gd-orig">{$d['original']}</span>{{endif}}
			</div>
			<div class="gd-deal-meta">
				{{if $d['free_ship']}}<span class="gd-badge gd-ship">{lang="gddeals_free_ship"}</span>{{endif}}
				{{if $d['shipping']}}<span class="gd-badge">{lang="gddeals_v_shipping"}: {$d['shipping']}</span>{{endif}}
				{{if $d['promo']}}<span class="gd-promo-chip">{lang="gddeals_v_promo"}: <strong>{$d['promo']}</strong></span>{{endif}}
			</div>
			{{if $d['deal_url']}}
				<a class="gd-deal-cta" href="{$d['deal_url']}" rel="nofollow noopener" target="_blank">{lang="gddeals_v_link"}</a>
			{{endif}}
			{{if $d['description']}}<div class="gd-deal-desc">{$d['description']}</div>{{endif}}
			<div class="gd-deal-byline">{lang="gddeals_by"} {$d['author_name']} · {$d['posted']}</div>
		</div>
	</div>
</div>
