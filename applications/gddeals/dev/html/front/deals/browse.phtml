<ips:template parameters="$cards, $cats, $activeCat, $activeSort, $activeQf, $pagination, $total, $sortUrls, $qfUrls, $csrfKey" />
<div class="gd-deals-wrap">
	<div class="gd-deals-header">
		<h1>{lang="gddeals_feed_title"}</h1>
		<a class="gd-post-btn" href="{url="app=gddeals&module=deals&controller=submit" seoTemplate="gddeals_submit"}">{lang="gddeals_post_deal"}</a>
	</div>

	<nav class="gd-cat-nav">
		<a href="{url="app=gddeals&module=deals&controller=browse" seoTemplate="gddeals_browse"}"{{if !$activeCat}} class="gd-active"{{endif}}>{lang="gddeals_cat_all"}</a>
		{{foreach $cats as $c}}
			<a href="{$c['url']}"{{if $activeCat == $c['id']}} class="gd-active"{{endif}}>{$c['title']}</a>
		{{endforeach}}
	</nav>

	<div class="gd-controls">
		<span class="gd-control-label">{lang="gddeals_sort_label"}</span>
		<div class="gd-seg">
			<a href="{$sortUrls['newest']}"{{if $activeSort == 'newest'}} class="gd-active"{{endif}}>{lang="gddeals_sort_newest"}</a>
			<a href="{$sortUrls['hottest']}"{{if $activeSort == 'hottest'}} class="gd-active"{{endif}}>{lang="gddeals_sort_hottest"}</a>
			<a href="{$sortUrls['discount']}"{{if $activeSort == 'discount'}} class="gd-active"{{endif}}>{lang="gddeals_sort_discount"}</a>
			<a href="{$sortUrls['expiring']}"{{if $activeSort == 'expiring'}} class="gd-active"{{endif}}>{lang="gddeals_sort_expiring"}</a>
		</div>
		<div class="gd-seg">
			<a href="{$qfUrls['under500']}"{{if $activeQf == 'under500'}} class="gd-active"{{endif}}>{lang="gddeals_qf_under500"}</a>
			<a href="{$qfUrls['today']}"{{if $activeQf == 'today'}} class="gd-active"{{endif}}>{lang="gddeals_qf_today"}</a>
		</div>
	</div>

	{{if $total == 0}}
		<div class="gd-empty">{lang="gddeals_feed_empty"}</div>
	{{else}}
		<div class="gd-deal-grid">
			{{foreach $cards as $d}}
				<div class="gd-deal-card">
					<a class="gd-card-main" href="{$d['url']}">
						{{if $d['image']}}
							<div class="gd-card-imgwrap"><img class="gd-card-img" src="{$d['image']}" alt="{$d['title']}"></div>
						{{endif}}
						<div class="gd-card-top">
							<span class="gd-card-cat">{$d['category']}</span>
							<div class="gd-card-title">{$d['title']}</div>
							<div class="gd-card-retailer">{$d['retailer']}</div>
						</div>
						<div class="gd-card-price">
							{{if $d['price']}}<span class="gd-price">{$d['price']}</span>{{endif}}
							{{if $d['discount']}}<span class="gd-discount">{$d['discount']}% {lang="gddeals_off"}</span>{{endif}}
							{{if $d['original']}}<span class="gd-orig">{$d['original']}</span>{{endif}}
						</div>
						{{if $d['promo'] or $d['free_ship']}}
							<div class="gd-card-badges">
								{{if $d['promo']}}<span class="gd-badge">{lang="gddeals_promo_badge"}</span>{{endif}}
								{{if $d['free_ship']}}<span class="gd-badge gd-ship">{lang="gddeals_free_ship"}</span>{{endif}}
							</div>
						{{endif}}
					</a>
					<div class="gd-card-foot">
						<div class="gd-card-foot-row">
							<span>{lang="gddeals_by"} {$d['author']} · {$d['posted']}{{if $d['expires']}} · {lang="gddeals_expires"} {$d['expires']}{{endif}}</span>
							{{if $d['heat_label'] != 'cold'}}<span class="gd-heat-badge gd-heat--{$d['heat_label']}">{$d['heat_text']}</span>{{endif}}
						</div>
						<div class="gd-vote-widget" data-vote-url="{$d['vote_url']}" data-csrf-key='{expression="\IPS\Session::i()->csrfKey"}'>
							<button class="gd-vote-btn{{if $d['user_vote'] == 1}} gd-voted{{endif}}" data-dir="up" title="Upvote">&#9650;</button>
							<span class="gd-vote-score">{$d['heat_score']}</span>
							<button class="gd-vote-btn{{if $d['user_vote'] == -1}} gd-voted{{endif}}" data-dir="down" title="Downvote">&#9660;</button>
						</div>
					</div>
				</div>
			{{endforeach}}
		</div>
		{$pagination|raw}
	{{endif}}
</div>
