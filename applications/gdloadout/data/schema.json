{
	"gd_loadouts": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"member_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false, "default": 0 },
			"name": { "type": "VARCHAR", "length": 100, "allow_null": false, "default": "" },
			"slug": { "type": "VARCHAR", "length": 120, "allow_null": false, "default": "" },
			"description": { "type": "TEXT", "length": 0, "allow_null": true, "default": null },
			"use_case": { "type": "VARCHAR", "length": 50, "allow_null": true, "default": null },
			"visibility": { "type": "VARCHAR", "length": 20, "allow_null": false, "default": "unlisted" },
			"upvotes": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 },
			"view_count": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 },
			"follow_count": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 },
			"comment_count": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 },
			"total_items": { "type": "SMALLINT", "length": 5, "unsigned": true, "allow_null": false, "default": 0 },
			"total_min_price": { "type": "DECIMAL", "length": "10,2", "allow_null": true, "default": null },
			"featured": { "type": "TINYINT", "length": 1, "unsigned": true, "allow_null": false, "default": 0 },
			"featured_position": { "type": "SMALLINT", "length": 5, "unsigned": true, "allow_null": false, "default": 0 },
			"created_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 },
			"updated_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": true, "default": null }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"member_id": { "type": "key", "columns": ["member_id"] },
			"slug": { "type": "key", "columns": ["member_id", "slug"] },
			"visibility": { "type": "key", "columns": ["visibility", "featured"] }
		}
	},
	"gd_loadout_items": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"loadout_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"upc": { "type": "VARCHAR", "length": 20, "allow_null": false, "default": "" },
			"slot_type": { "type": "VARCHAR", "length": 30, "allow_null": false, "default": "extra" },
			"custom_label": { "type": "VARCHAR", "length": 100, "allow_null": true, "default": null },
			"sort_order": { "type": "SMALLINT", "length": 5, "unsigned": true, "allow_null": false, "default": 0 },
			"notes": { "type": "VARCHAR", "length": 300, "allow_null": true, "default": null },
			"added_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"loadout_id": { "type": "key", "columns": ["loadout_id", "sort_order"] }
		}
	},
	"gd_loadout_votes": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"loadout_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"member_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"voted_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"unique_vote": { "type": "unique", "columns": ["loadout_id", "member_id"] }
		}
	},
	"gd_loadout_follows": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"loadout_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"member_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"followed_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"unique_follow": { "type": "unique", "columns": ["loadout_id", "member_id"] }
		}
	},
	"gd_loadout_comments": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"loadout_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"member_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"comment": { "type": "TEXT", "length": 0, "allow_null": false },
			"created_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"loadout_id": { "type": "key", "columns": ["loadout_id", "created_at"] }
		}
	},
	"gd_loadout_forum_posts": {
		"columns": {
			"id": { "type": "BIGINT", "length": 20, "unsigned": true, "auto_increment": true, "allow_null": false },
			"loadout_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"member_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"topic_id": { "type": "BIGINT", "length": 20, "unsigned": true, "allow_null": false },
			"posted_at": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false, "default": 0 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"loadout_member": { "type": "key", "columns": ["loadout_id", "member_id"] }
		}
	},
	"gd_loadout_group_limits": {
		"columns": {
			"id": { "type": "INT", "length": 10, "unsigned": true, "auto_increment": true, "allow_null": false },
			"group_id": { "type": "INT", "length": 10, "unsigned": true, "allow_null": false },
			"max_loadouts": { "type": "SMALLINT", "length": 5, "unsigned": true, "allow_null": false, "default": 10 },
			"max_slots": { "type": "SMALLINT", "length": 5, "unsigned": true, "allow_null": false, "default": 25 }
		},
		"indexes": {
			"PRIMARY": { "type": "primary", "columns": ["id"] },
			"group_id": { "type": "unique", "columns": ["group_id"] }
		}
	}
}
