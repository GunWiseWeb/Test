<ips:template parameters="$loadouts" />
<div class="gdlo-widget">
    <h3 class="gdlo-widget-title"><i class="fa-solid fa-fire"></i> {lang="gdloadout_trending"}</h3>
    {{if count($loadouts) > 0}}
    <div class="gdlo-widget-list">
        {{foreach $loadouts as $loadout}}
        <a href="{$loadout['view_url']}" class="gdlo-widget-item">
            <span class="gdlo-widget-item-name">{$loadout['name']}</span>
            <span class="gdlo-widget-item-meta">
                <span class="gdlo-widget-item-author">{$loadout['owner_name']}</span>
                <span class="gdlo-widget-item-votes"><i class="fa-solid fa-heart"></i> {$loadout['upvotes']}</span>
            </span>
        </a>
        {{endforeach}}
    </div>
    {{else}}
    <p class="gdlo-widget-empty">{lang="gdloadout_no_trending"}</p>
    {{endif}}
</div>
